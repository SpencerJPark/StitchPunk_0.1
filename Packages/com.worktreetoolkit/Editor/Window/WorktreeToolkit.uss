/* Worktree Toolkit node window — style reference: Cult of the Lamb tech-tree screen
   (Assets/_Vault/Tasks/Claude/Cult-of-the-Lamb10312022-092045-91069.jpg).
   Black bars, charcoal ground, teal/crimson lit tiles, cream text and key badges. */

:root {
    --worktree-color-ground: rgb(22, 22, 22);
    --worktree-color-bar: rgb(8, 8, 8);
    --worktree-color-tile: rgb(44, 46, 45);
    --worktree-color-tile-lit: rgb(74, 88, 84);
    --worktree-color-line-locked: rgb(60, 60, 60);
    --worktree-color-line-locked-hover: rgb(90, 90, 90);
    --worktree-color-teal: rgb(32, 190, 158);
    --worktree-color-teal-hover: rgb(80, 220, 190);
    --worktree-color-crimson: rgb(200, 32, 30);
    --worktree-color-cream: rgb(240, 234, 214);
    --worktree-color-cream-dim: rgba(240, 234, 214, 0.45);
    --worktree-color-selection: rgb(245, 245, 245);
    --worktree-color-amber: rgb(232, 170, 60);
}

.worktree-window {
    flex-grow: 1;
    background-color: var(--worktree-color-ground);
}

/* Header bar */

.worktree-header {
    flex-direction: row;
    align-items: center;
    height: 34px;
    background-color: var(--worktree-color-bar);
    padding-left: 8px;
    padding-right: 8px;
}

.worktree-header__title {
    color: var(--worktree-color-cream);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.worktree-header__ornament {
    color: var(--worktree-color-cream-dim);
    font-size: 12px;
    margin-left: 4px;
    margin-right: 4px;
    -unity-text-align: middle-center;
}

.worktree-header__stage-chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--worktree-color-bar);
    border-width: 1px;
    border-color: var(--worktree-color-cream);
    border-radius: 3px;
    padding-left: 8px;
    padding-right: 8px;
    height: 22px;
    color: var(--worktree-color-cream);
    font-size: 11px;
    margin-left: 8px;
}

.worktree-header__stage-chip:hover {
    background-color: rgba(240, 234, 214, 0.08);
}

.worktree-header__badge {
    color: var(--worktree-color-amber);
    font-size: 11px;
    -unity-font-style: bold;
    margin-left: 6px;
}

.worktree-header__broker-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--worktree-color-line-locked);
    margin-left: 4px;
}

.worktree-header__broker-dot--alive {
    background-color: var(--worktree-color-teal);
}

/* Status line */

.worktree-status-line {
    height: 20px;
    background-color: var(--worktree-color-bar);
    justify-content: center;
    padding-left: 10px;
}

.worktree-status-line__text {
    color: var(--worktree-color-cream-dim);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.worktree-status-line__text--busy {
    color: var(--worktree-color-amber);
}

.worktree-status-line__text--error {
    color: var(--worktree-color-crimson);
}

/* Inline create row */

.worktree-create-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--worktree-color-bar);
    padding: 4px 8px;
}

/* Canvas */

.worktree-canvas {
    flex-grow: 1;
    background-color: var(--worktree-color-ground);
}

.worktree-empty-hint {
    color: var(--worktree-color-cream-dim);
    font-size: 11px;
    -unity-text-align: upper-center;
    white-space: nowrap;
}

/* Node / tile */

.worktree-node {
    position: absolute;
}

.worktree-node__tile {
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: var(--worktree-color-line-locked);
    background-color: var(--worktree-color-tile);
    border-radius: 2px;
}

.worktree-node__tile--locked {
    border-width: 2px;
    border-color: var(--worktree-color-line-locked);
    background-color: var(--worktree-color-tile);
}

.worktree-node__tile--locked:hover {
    border-color: var(--worktree-color-line-locked-hover);
}

.worktree-node__tile--unlocked {
    border-width: 3px;
    border-color: var(--worktree-color-teal);
    background-color: var(--worktree-color-tile-lit);
}

.worktree-node__tile--unlocked:hover {
    border-color: var(--worktree-color-teal-hover);
}

.worktree-node__tile--on-stage {
    border-width: 3px;
    border-color: var(--worktree-color-crimson);
    background-color: var(--worktree-color-tile-lit);
}

.worktree-node__tile--on-stage:hover {
    border-color: var(--worktree-color-crimson);
}

.worktree-node__glyph {
    width: 52px;
    height: 52px;
}

.worktree-node__lock {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 20px;
    height: 20px;
}

/* crimson band across the bottom of the tile that has this window open in the Editor */
.worktree-node__ribbon {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 16px;
    background-color: var(--worktree-color-crimson);
    color: var(--worktree-color-cream);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.worktree-node__pip {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--worktree-color-amber);
}

.worktree-node__caption {
    color: var(--worktree-color-cream-dim);
    font-size: 11px;
    -unity-text-align: upper-center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 168px;
}

.worktree-node__caption--selected {
    color: var(--worktree-color-cream);
    font-size: 12px;
    -unity-font-style: bold;
    background-color: var(--worktree-color-bar);
    padding: 2px 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 168px;
}

.worktree-node__selection {
    position: absolute;
    border-width: 2px;
    border-color: var(--worktree-color-selection);
    border-radius: 6px;
}

/* Legend (canvas top-right) */

.worktree-legend {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: rgba(8, 8, 8, 0.92);
    border-width: 1px;
    border-color: var(--worktree-color-line-locked);
    border-radius: 4px;
    padding: 8px 10px;
}

.worktree-legend__title {
    color: var(--worktree-color-cream-dim);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.worktree-legend__row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.worktree-legend__swatch {
    width: 12px;
    height: 12px;
    border-width: 3px;
    border-radius: 2px;
    background-color: var(--worktree-color-tile-lit);
}

.worktree-legend__swatch--crimson {
    border-color: var(--worktree-color-crimson);
}

.worktree-legend__swatch--teal {
    border-color: var(--worktree-color-teal);
}

.worktree-legend__swatch--locked {
    border-color: var(--worktree-color-line-locked);
    background-color: var(--worktree-color-tile);
}

.worktree-legend__label {
    color: var(--worktree-color-cream);
    font-size: 11px;
    margin-left: 8px;
}

.worktree-legend__hint {
    color: var(--worktree-color-cream);
    font-size: 11px;
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--worktree-color-line-locked);
    max-width: 200px;
    white-space: normal;
}

/* Divider + gate strip */

.worktree-divider {
    height: 2px;
    background-color: var(--worktree-color-cream);
    margin-top: 28px;
}

.worktree-queue-strip {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
}

.worktree-queue-chip {
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: var(--worktree-color-line-locked);
    border-radius: 3px;
    padding: 2px 6px;
    margin-right: 6px;
    color: var(--worktree-color-cream-dim);
    font-size: 11px;
}

.worktree-queue-chip--active {
    border-color: var(--worktree-color-teal);
    color: var(--worktree-color-cream);
}

/* Inspector */

.worktree-inspector {
    background-color: var(--worktree-color-ground);
    padding: 8px;
}

.worktree-inspector__title {
    color: var(--worktree-color-cream);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.worktree-inspector__status {
    color: var(--worktree-color-cream-dim);
    font-size: 12px;
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 10px;
}

.worktree-inspector__section {
    color: var(--worktree-color-cream-dim);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-top: 12px;
    margin-bottom: 6px;
}

.worktree-kv {
    flex-direction: row;
    margin-bottom: 4px;
}

.worktree-kv__key {
    color: var(--worktree-color-cream-dim);
    font-size: 11px;
    width: 84px;
    -unity-text-align: middle-left;
}

.worktree-kv__value {
    color: var(--worktree-color-cream);
    font-size: 12px;
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    flex-grow: 1;
}

/* the worktree path wraps instead of ellipsizing so the full path stays readable */
.worktree-kv__value--path {
    overflow: visible;
    white-space: normal;
    text-overflow: clip;
}

.worktree-kv__copy {
    height: 18px;
    padding: 0 6px;
    font-size: 10px;
    color: var(--worktree-color-cream);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--worktree-color-line-locked);
    border-radius: 3px;
    margin-left: 6px;
}

.worktree-inspector__rule {
    height: 1px;
    background-color: var(--worktree-color-line-locked);
    margin-top: 8px;
    margin-bottom: 8px;
}

/* Action buttons */

.worktree-action {
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    width: 100%;
    min-height: 44px;
    margin: 0 0 6px 0;
    padding: 8px 10px;
    background-color: rgba(240, 234, 214, 0.04);
    border-width: 1px;
    border-color: var(--worktree-color-line-locked);
    border-left-width: 4px;
    border-radius: 4px;
}

.worktree-action:hover {
    background-color: rgba(240, 234, 214, 0.09);
}

.worktree-action:disabled {
    opacity: 0.55;
}

.worktree-action--teal {
    border-left-color: var(--worktree-color-teal);
}

.worktree-action--crimson {
    border-left-color: var(--worktree-color-crimson);
}

.worktree-action--neutral {
    border-left-color: var(--worktree-color-line-locked);
}

.worktree-action__icon {
    width: 16px;
    height: 16px;
    margin-right: 10px;
    margin-top: 2px;
}

.worktree-action__title {
    color: var(--worktree-color-cream);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
}

.worktree-action__description {
    color: var(--worktree-color-cream-dim);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: upper-left;
    margin-top: 2px;
}

.worktree-action__description--blocked {
    color: var(--worktree-color-amber);
}

/* Footer bar */

.worktree-footer {
    flex-direction: row;
    align-items: center;
    height: 30px;
    background-color: var(--worktree-color-bar);
    padding-left: 8px;
    padding-right: 8px;
}

.worktree-footer__hint {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.worktree-footer__gesture {
    color: var(--worktree-color-cream);
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.worktree-footer__word {
    color: var(--worktree-color-cream-dim);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.worktree-footer__separator {
    color: var(--worktree-color-cream-dim);
    font-size: 11px;
    margin: 0 10px;
}

/* Icons and icon buttons */

.worktree-icon {
    width: 16px;
    height: 16px;
}

.worktree-icon-button {
    width: 24px;
    height: 22px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
}

.worktree-icon-button:hover {
    background-color: rgba(240, 234, 214, 0.08);
}

.worktree-icon-button--with-text {
    width: auto;
    flex-direction: row;
    padding-left: 6px;
    padding-right: 6px;
}

.worktree-header .worktree-icon-button--with-text {
    height: 24px;
    padding: 0 8px;
    margin-left: 6px;
    background-color: rgba(240, 234, 214, 0.06);
    border-width: 1px;
    border-color: var(--worktree-color-line-locked);
    border-radius: 4px;
    color: var(--worktree-color-cream);
}

.worktree-header .worktree-icon-button--with-text:hover {
    background-color: rgba(240, 234, 214, 0.12);
}

.worktree-icon-button__label {
    color: var(--worktree-color-cream);
    font-size: 12px;
    margin-left: 4px;
    -unity-text-align: middle-left;
}
