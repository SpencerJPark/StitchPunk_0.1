<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/com.dotsanimationtoolkit/Editor/ClipEditor/ClipEditorWindow.uss?fileID=7433441132597879392&amp;guid=9f9579bb3bb5224498fd9bfa8e54f406&amp;type=3#ClipEditorWindow"/>
    <ui:VisualElement name="clip-editor-root" class="clip-editor__root">
        <uie:Toolbar name="clip-editor-toolbar" class="clip-editor__toolbar">
            <ui:VisualElement name="tab-strip" class="clip-editor__tab-strip">
                <uie:ToolbarToggle name="tab-texture-packer" text="Texture Packer" class="clip-editor__tab"/>
                <uie:ToolbarToggle name="tab-clip-sets" text="Clip Sets" class="clip-editor__tab"/>
                <uie:ToolbarToggle name="tab-new-rig" text="Rigs" class="clip-editor__tab"/>
                <uie:ToolbarToggle name="tab-clip-editor" text="Clip Editor" value="true" class="clip-editor__tab"/>
                <uie:ToolbarToggle name="tab-vat-bake" text="VAT Bake" class="clip-editor__tab"/>
                <uie:ToolbarToggle name="tab-actor-editor" text="Actor Profiles" class="clip-editor__tab"/>
                <uie:ToolbarToggle name="tab-cutscene-editor" text="Cutscene Director" class="clip-editor__tab"/>
            </ui:VisualElement>
            <ui:VisualElement name="validation-badge-slot" class="clip-editor__badge-slot"/>
        </uie:Toolbar>
        <ui:VisualElement name="clip-editor-body" class="clip-editor__body">
            <ui:TwoPaneSplitView name="dock-vertical" orientation="Vertical" fixed-pane-index="1" fixed-pane-initial-dimension="220" class="clip-editor__dock">
                <ui:TwoPaneSplitView name="dock-columns" orientation="Horizontal" fixed-pane-index="0" fixed-pane-initial-dimension="240">
                    <ui:TwoPaneSplitView name="dock-left" orientation="Vertical" fixed-pane-index="0" fixed-pane-initial-dimension="150">
                        <ui:VisualElement name="clip-list-pane" class="clip-editor__pane">
                            <ui:VisualElement class="toolkit-pane-header">
                                <ui:Label text="Clips" class="toolkit-pane-title"/>
                                <ui:VisualElement class="toolkit-pane-actions">
                                    <ui:Button name="new-clip-button" text="New" class="toolkit-pane-action"/>
                                    <ui:Button name="delete-clip-button" text="Delete" class="toolkit-pane-action"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <uie:ObjectField name="clip-set-field" class="clip-editor__pane-field"/>
                            <ui:ListView name="clip-list" class="clip-editor__clip-list"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="hierarchy-pane" class="clip-editor__pane">
                            <ui:VisualElement class="toolkit-pane-header">
                                <ui:Label text="Rig Hierarchy" class="toolkit-pane-title"/>
                                <ui:VisualElement class="toolkit-pane-actions">
                                    <uie:ToolbarToggle name="rig-edit-toggle" text="Edit" class="toolkit-pane-action clip-editor__pane-chrome clip-editor__rig-edit-toggle"/>
                                    <uie:ToolbarButton name="edit-prefab-button" text="Prefab" class="toolkit-pane-action clip-editor__pane-chrome"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <uie:ObjectField name="skinned-source-field" class="clip-editor__pane-field"/>
                            <ui:Label name="hierarchy-empty-label" text="Pick a rig above to list its transforms." class="clip-editor__hint"/>
                            <ui:TreeView name="hierarchy-tree" class="clip-editor__hierarchy"/>
                        </ui:VisualElement>
                    </ui:TwoPaneSplitView>
                    <ui:TwoPaneSplitView name="dock-right" orientation="Horizontal" fixed-pane-index="1" fixed-pane-initial-dimension="280">
                        <ui:VisualElement name="viewport-pane" class="clip-editor__pane clip-editor__viewport-pane">
                            <ui:Label name="rig-edit-banner" class="clip-editor__mode-banner clip-editor--hidden"/>
                            <ui:Label name="viewport-status" class="clip-editor__viewport-status"/>
                            <ui:VisualElement name="viewport-frame" class="clip-editor__viewport-frame">
                                <ui:Image name="viewport-image" class="clip-editor__viewport"/>
                                <ui:VisualElement name="viewport-overlay" picking-mode="Ignore" class="clip-editor__viewport-overlay">
                                    <ui:VisualElement name="overlay-tool-row" class="clip-editor__overlay-column">
                                        <uie:ToolbarToggle name="gizmo-move-toggle" value="true" class="clip-editor__overlay-tool-button">
                                            <ui:Image name="gizmo-move-icon" picking-mode="Ignore" class="clip-editor__overlay-tool-icon"/>
                                        </uie:ToolbarToggle>
                                        <uie:ToolbarToggle name="gizmo-rotate-toggle" class="clip-editor__overlay-tool-button">
                                            <ui:Image name="gizmo-rotate-icon" picking-mode="Ignore" class="clip-editor__overlay-tool-icon"/>
                                        </uie:ToolbarToggle>
                                        <uie:ToolbarToggle name="gizmo-scale-toggle" class="clip-editor__overlay-tool-button">
                                            <ui:Image name="gizmo-scale-icon" picking-mode="Ignore" class="clip-editor__overlay-tool-icon"/>
                                        </uie:ToolbarToggle>
                                        <uie:ToolbarButton name="reset-camera-button" class="clip-editor__overlay-tool-button clip-editor__overlay-run-break">
                                            <ui:Image name="reset-camera-icon" picking-mode="Ignore" class="clip-editor__overlay-tool-icon"/>
                                        </uie:ToolbarButton>
                                        <uie:ToolbarToggle name="billboard-preview-toggle" value="true" class="clip-editor__overlay-tool-button clip-editor__overlay-run-break">
                                            <ui:Image name="billboard-preview-icon" picking-mode="Ignore" class="clip-editor__overlay-tool-icon"/>
                                        </uie:ToolbarToggle>
                                        <uie:ToolbarToggle name="ragdoll-preview-toggle" class="clip-editor__overlay-tool-button">
                                            <ui:Image name="ragdoll-preview-icon" picking-mode="Ignore" class="clip-editor__overlay-tool-icon"/>
                                        </uie:ToolbarToggle>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="reconcile-panel" class="clip-editor__reconcile clip-editor--hidden">
                                <ui:VisualElement class="clip-editor__reconcile-header">
                                    <ui:Label name="reconcile-title" class="clip-editor__reconcile-title"/>
                                    <ui:Button name="reconcile-dismiss-button" text="Dismiss" class="toolkit-pane-action"/>
                                </ui:VisualElement>
                                <ui:ScrollView name="reconcile-list" class="clip-editor__reconcile-list"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="inspector-pane" class="clip-editor__pane">
                            <ui:Label text="Clip Inspector" class="toolkit-pane-title"/>
                            <ui:ScrollView name="inspector-content" class="clip-editor__inspector"/>
                        </ui:VisualElement>
                    </ui:TwoPaneSplitView>
                </ui:TwoPaneSplitView>
                <ui:VisualElement name="timeline-pane" class="clip-editor__pane">
                    <ui:VisualElement name="transport-bar" class="toolkit-transport">
                        <ui:VisualElement class="toolkit-transport__group">
                            <ui:Label name="length-caption" text="Length" class="toolkit-transport__caption"/>
                            <ui:FloatField name="clip-length-field" class="toolkit-transport__field"/>
                            <ui:Label name="frame-rate-caption" text="FPS" class="toolkit-transport__caption"/>
                            <ui:IntegerField name="frame-rate-field" class="toolkit-transport__field"/>
                            <ui:Label name="frame-count-label" text="0 frames" class="toolkit-transport__caption toolkit-transport__derived"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="transport-core-slot" class="toolkit-transport__group"/>
                        <ui:VisualElement class="toolkit-transport__group">
                            <ui:Label name="frame-caption" text="Frame" class="toolkit-transport__caption"/>
                            <ui:IntegerField name="current-frame-field" class="toolkit-transport__field"/>
                            <ui:Label name="seconds-caption" text="Time" class="toolkit-transport__caption"/>
                            <ui:FloatField name="current-seconds-field" class="toolkit-transport__field"/>
                            <ui:Label name="speed-caption" text="Speed" class="toolkit-transport__caption"/>
                            <ui:FloatField name="playback-speed-field" class="toolkit-transport__field"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="toolkit-transport__group">
                            <ui:Label text="Zoom" class="toolkit-transport__caption"/>
                            <ui:Slider name="zoom-slider" class="clip-editor__transport-slider"/>
                            <ui:Button name="frame-all-button" text="All" class="toolkit-icon-button toolkit-icon-button--text"/>
                            <ui:Button name="frame-selection-button" text="Selected" class="toolkit-icon-button toolkit-icon-button--text"/>
                        </ui:VisualElement>
                        <ui:Label name="transform-readout" class="clip-editor__transform-readout"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="timeline-status-row" class="toolkit-status-row">
                        <ui:Label name="timeline-status" text="Assign a clip set." class="toolkit-status"/>
                        <ui:VisualElement class="toolkit-status-actions">
                            <uie:ToolbarButton name="quantize-keys-button" text="Quantize Keys" class="clip-editor__bar-action clip-editor__quantize-action"/>
                            <uie:ToolbarButton name="add-event-button" text="Add Event" class="clip-editor__bar-action clip-editor__status-action"/>
                            <uie:ToolbarToggle name="snap-toggle" text="Snap" value="true" class="clip-editor__bar-action clip-editor__status-toggle clip-editor__status-action"/>
                            <uie:ToolbarToggle name="auto-key-toggle" text="Auto Key" class="clip-editor__bar-action clip-editor__status-toggle clip-editor__status-action"/>
                            <ui:DropdownField name="pivot-dropdown" class="clip-editor__status-dropdown"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView name="timeline-scroll" mode="Vertical" class="clip-editor__timeline-scroll">
                        <ui:VisualElement name="timeline-row" class="clip-editor__timeline-row">
                            <ui:VisualElement name="track-header-stack" class="clip-editor__track-header-stack">
                                <ui:VisualElement class="clip-editor__track-header-spacer"/>
                                <ui:VisualElement name="track-header-column"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="track-header-resizer" class="clip-editor__track-header-resizer"/>
                            <ui:VisualElement name="lane-stack" focusable="true" class="clip-editor__lane-stack">
                                <ui:VisualElement name="lane-column"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:TwoPaneSplitView>
            <ui:VisualElement name="texture-packer-pane" class="clip-editor__cover-pane clip-editor--hidden"/>
            <ui:VisualElement name="vat-bake-pane" class="clip-editor__cover-pane clip-editor--hidden"/>
            <ui:VisualElement name="new-rig-pane" class="clip-editor__cover-pane clip-editor--hidden"/>
            <ui:VisualElement name="clip-sets-pane" class="clip-editor__cover-pane clip-editor--hidden"/>
            <ui:VisualElement name="actor-editor-pane" class="clip-editor__cover-pane clip-editor--hidden"/>
            <ui:VisualElement name="cutscene-pane" class="clip-editor__cover-pane clip-editor--hidden"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
