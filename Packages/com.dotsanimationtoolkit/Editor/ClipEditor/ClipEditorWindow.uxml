<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <!--
        The clip editor's persistent dock (architecture section 7.1).

        The three zones are declared here rather than assembled in CreateGUI so the layout survives
        as a thing a person can open and read. Every split is a TwoPaneSplitView, so every boundary
        in the window is draggable; ClipEditorWindow restores and stores each one's position in
        EditorPrefs, which is why the dimensions below are only first-run defaults.

        Named elements are contracts with ClipEditorWindow.cs — renaming one silently empties a
        pane, because a Q<T>(name) miss is a null, not an error.

        Custom elements (the ruler, the lanes, the playhead, the validation badge) are added from
        C# into the slots below. They have no UXML factories, and giving them one would buy nothing:
        nothing but this window ever instantiates them.
    -->
    <Style src="project://database/Packages/com.dotsanimationtoolkit/Editor/ClipEditor/ClipEditorWindow.uss" />

    <ui:VisualElement name="clip-editor-root" class="clip-editor__root">

        <uie:Toolbar name="clip-editor-toolbar" class="clip-editor__toolbar">
            <ui:Label text="Clip Set" class="clip-editor__toolbar-label" />
            <uie:ObjectField name="clip-set-field" class="clip-editor__object-field" />
            <uie:ToolbarButton name="new-clip-set-button" text="New Set" />
            <!-- Playback and timing used to live here. They now sit in the transport bar docked
                 above the timeline, so everything about WHEN is in one place and this toolbar is
                 only about what an edit writes. -->
            <uie:ToolbarToggle name="snap-toggle" text="Snap" value="true" />
            <uie:ToolbarToggle name="auto-key-toggle" text="Auto Key" />
            <!-- Mode switch. Off = animate (gizmos key), on = rig edit (gizmos write the base
                 pose). Deliberately adjacent to Auto Key, the other control that decides what a
                 drag writes. -->
            <uie:ToolbarToggle name="rig-edit-toggle" text="Rig Edit"
                               class="clip-editor__rig-edit-toggle" />
            <!-- Billboarding is on by default because a preview that silently differs from the
                 game is worse than no preview. It is switchable because a billboarded rig faces
                 the camera from every angle, which makes the authored pose impossible to see. -->
            <uie:ToolbarToggle name="billboard-preview-toggle" text="Billboard" value="true" />
            <ui:Label text="Rig" class="clip-editor__toolbar-label" />
            <uie:ObjectField name="skinned-source-field" class="clip-editor__object-field" />
            <ui:VisualElement name="validation-badge-slot" class="clip-editor__badge-slot" />
        </uie:Toolbar>

        <!--
            Outer zone split: editing area over timeline. The timeline is the fixed pane so that
            growing the window grows the viewport, which is the pane that benefits from the pixels.
            220px is roughly a quarter of the default window height; the window overrides it with
            0.25 * height on a first run and with the stored position after that.
        -->
        <ui:TwoPaneSplitView name="dock-vertical" class="clip-editor__dock"
                             orientation="Vertical" fixed-pane-index="1" fixed-pane-initial-dimension="220">

            <!-- Editing area: hierarchy | viewport | inspector, as two nested horizontal splits. -->
            <ui:TwoPaneSplitView name="dock-columns"
                                 orientation="Horizontal" fixed-pane-index="0" fixed-pane-initial-dimension="240">

                <!-- Left column. Clips over hierarchy, itself split so either can be given the room. -->
                <ui:TwoPaneSplitView name="dock-left"
                                     orientation="Vertical" fixed-pane-index="0" fixed-pane-initial-dimension="150">
                    <ui:VisualElement name="clip-list-pane" class="clip-editor__pane">
                        <ui:VisualElement class="clip-editor__pane-header">
                            <ui:Label text="Clips" class="clip-editor__pane-title" />
                            <ui:VisualElement class="clip-editor__pane-actions">
                                <ui:Button name="new-clip-button" text="New" class="clip-editor__pane-action" />
                                <ui:Button name="delete-clip-button" text="Delete" class="clip-editor__pane-action" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:ListView name="clip-list" class="clip-editor__clip-list" />
                    </ui:VisualElement>
                    <ui:VisualElement name="hierarchy-pane" class="clip-editor__pane">
                        <ui:VisualElement class="clip-editor__pane-header">
                            <ui:Label text="Hierarchy" class="clip-editor__pane-title" />
                            <ui:VisualElement class="clip-editor__pane-actions">
                                <ui:Button name="add-socket-button" text="+ Socket"
                                           class="clip-editor__pane-action" />
                                <!-- Toggles rather than adds: a node either is a billboard root
                                     or is not, and one button that reads the selection says so
                                     more clearly than an add/remove pair. -->
                                <ui:Button name="billboard-root-button" text="+ Billboard"
                                           class="clip-editor__pane-action" />
                                <ui:Button name="edit-prefab-button" text="Edit Prefab"
                                           class="clip-editor__pane-action" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="hierarchy-empty-label" class="clip-editor__hint"
                                  text="Assign a rig in the toolbar to list its transforms." />
                        <ui:TreeView name="hierarchy-tree" class="clip-editor__hierarchy" />
                    </ui:VisualElement>
                </ui:TwoPaneSplitView>

                <!-- Viewport | inspector. The inspector is fixed so the viewport takes the slack. -->
                <ui:TwoPaneSplitView name="dock-right"
                                     orientation="Horizontal" fixed-pane-index="1" fixed-pane-initial-dimension="280">
                    <ui:VisualElement name="viewport-pane" class="clip-editor__pane clip-editor__viewport-pane">
                        <!-- Mode banner. Hidden in Animate mode; in Rig Edit it tints the viewport
                             frame so a gizmo drag is never ambiguous about what it writes. -->
                        <ui:Label name="rig-edit-banner" class="clip-editor__mode-banner clip-editor--hidden" />
                        <ui:Label name="viewport-status" class="clip-editor__viewport-status" />
                        <ui:VisualElement name="viewport-frame" class="clip-editor__viewport-frame">
                            <ui:Image name="viewport-image" class="clip-editor__viewport" />
                        </ui:VisualElement>
                        <!-- Reconciliation. Appears only after a prefab edit broke a binding. -->
                        <ui:VisualElement name="reconcile-panel"
                                          class="clip-editor__reconcile clip-editor--hidden">
                            <ui:VisualElement class="clip-editor__reconcile-header">
                                <ui:Label name="reconcile-title" class="clip-editor__reconcile-title" />
                                <ui:Button name="reconcile-dismiss-button" text="Dismiss"
                                           class="clip-editor__pane-action" />
                            </ui:VisualElement>
                            <ui:ScrollView name="reconcile-list" class="clip-editor__reconcile-list" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="inspector-pane" class="clip-editor__pane">
                        <ui:Label text="Inspector" class="clip-editor__pane-title" />
                        <ui:ScrollView name="inspector-content" class="clip-editor__inspector" />
                    </ui:VisualElement>
                </ui:TwoPaneSplitView>

            </ui:TwoPaneSplitView>

            <!--
                Timeline zone. The header column and the lane stack scroll together inside one
                ScrollView: a quarter-height pane cannot show a deep clip's tracks otherwise, and
                two independent scrollers would let the headers drift out of line with their lanes.
            -->
            <ui:VisualElement name="timeline-pane" class="clip-editor__pane">

                <!--
                    Transport bar. Docked immediately above the timeline on purpose: every control
                    here answers "when", and the thing they act on is directly below them. Reading
                    order across the bar is deliberate — move the playhead, read where it is, then
                    the two fields that define the frame grid, then how playback behaves.
                -->
                <ui:VisualElement name="transport-bar" class="clip-editor__transport">

                    <ui:VisualElement class="clip-editor__transport-group">
                        <ui:Button name="jump-start-button" text="|&lt;" class="clip-editor__transport-button" />
                        <ui:Button name="step-back-button" text="&lt;" class="clip-editor__transport-button" />
                        <ui:Button name="play-toggle" text="Play" class="clip-editor__transport-button clip-editor__transport-play" />
                        <ui:Button name="step-forward-button" text="&gt;" class="clip-editor__transport-button" />
                        <ui:Button name="jump-end-button" text="&gt;|" class="clip-editor__transport-button" />
                    </ui:VisualElement>

                    <!-- The readout is editable in BOTH units, because "frame 12" and "0.4s" are
                         the two ways an author already thinks about the same instant. -->
                    <ui:VisualElement class="clip-editor__transport-group">
                        <ui:Label text="Frame" class="clip-editor__transport-label" />
                        <ui:IntegerField name="current-frame-field" class="clip-editor__transport-field" />
                        <ui:Label text="Time" class="clip-editor__transport-label" />
                        <ui:FloatField name="current-seconds-field" class="clip-editor__transport-field" />
                    </ui:VisualElement>

                    <!-- Length and rate define the grid; the count is derived and therefore
                         read-only, so it can never disagree with the two fields above it. -->
                    <ui:VisualElement class="clip-editor__transport-group">
                        <ui:Label text="Length" class="clip-editor__transport-label" />
                        <ui:FloatField name="clip-length-field" class="clip-editor__transport-field" />
                        <ui:Label text="FPS" class="clip-editor__transport-label" />
                        <ui:FloatField name="frame-rate-field" class="clip-editor__transport-field" />
                        <ui:Label name="frame-count-label" text="0 frames"
                                  class="clip-editor__transport-label clip-editor__transport-derived" />
                    </ui:VisualElement>

                    <ui:VisualElement class="clip-editor__transport-group">
                        <ui:Toggle name="loop-toggle" label="Loop" class="clip-editor__transport-toggle" />
                        <ui:Label text="Speed" class="clip-editor__transport-label" />
                        <ui:FloatField name="playback-speed-field" class="clip-editor__transport-field" />
                    </ui:VisualElement>

                    <!-- Zoom is a slider AND two framing buttons on purpose: the slider says at a
                         glance how far in you are, which a scroll-wheel-only zoom never does. -->
                    <ui:VisualElement class="clip-editor__transport-group">
                        <ui:Label text="Zoom" class="clip-editor__transport-label" />
                        <ui:Slider name="zoom-slider" low-value="0.25" high-value="20"
                                   class="clip-editor__transport-slider" />
                        <ui:Button name="frame-all-button" text="Frame All"
                                   class="clip-editor__transport-button" />
                        <ui:Button name="frame-selection-button" text="Frame Sel"
                                   class="clip-editor__transport-button" />
                    </ui:VisualElement>

                    <ui:Button name="quantize-keys-button" text="Quantize Keys"
                               class="clip-editor__transport-button clip-editor__transport-action" />
                </ui:VisualElement>

                <ui:Label name="timeline-status" text="Assign a clip set." class="clip-editor__status" />
                <ui:ScrollView name="timeline-scroll" mode="Vertical" class="clip-editor__timeline-scroll">
                    <ui:VisualElement name="timeline-row" class="clip-editor__timeline-row">
                        <ui:VisualElement name="track-header-stack" class="clip-editor__track-header-stack">
                            <!-- Exactly the ruler's height, so header row N lines up with lane row N. -->
                            <ui:VisualElement class="clip-editor__track-header-spacer" />
                            <ui:VisualElement name="track-header-column" />
                        </ui:VisualElement>
                        <ui:VisualElement name="lane-stack" class="clip-editor__lane-stack" focusable="true">
                            <ui:VisualElement name="lane-column" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

        </ui:TwoPaneSplitView>

    </ui:VisualElement>
</ui:UXML>
