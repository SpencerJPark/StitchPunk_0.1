/*
 * Every size and space in the clip editor lives here (architecture section 7.1).
 *
 * The window and its timeline elements set no inline layout styles of their own. That is not
 * tidiness: an inline style beats every rule in this file, so a single leftover `style.height`
 * is a value nobody can override and nobody can find. Colours stay in C# where they encode state
 * (selected, error, warning) and are chosen per draw call by Painter2D rather than by USS.
 *
 * TimeRulerElement, TrackLaneElement, PlayheadElement and ValidationBadgeElement take their sizes
 * from the classes below, so they are only fully styled inside a tree carrying this stylesheet.
 * ClipEditorWindow.uxml is the only place that does; nothing else in the package instantiates them.
 */

/* ------------------------------------------------------------------------------------------- */
/* Root and shared tokens                                                                        */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__root {
    flex-grow: 1;

    /*
     * The header column and the lane column are two separate stacks that must agree row for row.
     * These are the numbers that make them agree: the spacer above the headers is exactly the
     * ruler's height, and a header is exactly a lane's height. Declared once so the alignment
     * cannot be broken by editing one of a pair.
     */
    --clip-editor-ruler-height: 20px;
    --clip-editor-lane-height: 22px;
    --clip-editor-track-header-width: 170px;
}

.clip-editor--hidden {
    display: none;
}

/* ------------------------------------------------------------------------------------------- */
/* Toolbar                                                                                       */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__toolbar {
    flex-shrink: 0;
}

.clip-editor__toolbar-label {
    -unity-text-align: middle-left;
    margin-left: 4px;
    margin-right: 4px;
}

.clip-editor__time-label {
    width: 66px;
}

.clip-editor__object-field {
    width: 200px;
}

.clip-editor__frame-field {
    width: 44px;
}

.clip-editor__badge-slot {
    flex-direction: column;
}

/* ------------------------------------------------------------------------------------------- */
/* Dock and panes                                                                                */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__dock {
    flex-grow: 1;
}

/*
 * Minimums, not sizes. TwoPaneSplitView clamps a drag against the panes' min-width / min-height,
 * so these are what stop a boundary being dragged over a pane and leaving it at zero pixels with
 * no visible handle to drag it back out.
 */
.clip-editor__pane {
    flex-direction: column;
    overflow: hidden;
    min-width: 80px;
    min-height: 48px;
}

.clip-editor__pane-title {
    -unity-font-style: bold;
    padding-top: 4px;
    padding-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
}

/* A title with an action button pushed to the right edge of the pane. */
.clip-editor__pane-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.clip-editor__pane-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.clip-editor__pane-action {
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
}

.clip-editor__hint {
    white-space: normal;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 2px;
    margin-bottom: 2px;
    opacity: 0.7;
}

/* ------------------------------------------------------------------------------------------- */
/* Clip list and prefab hierarchy                                                                */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__clip-list {
    flex-grow: 1;
}

.clip-editor__clip-row {
    -unity-text-align: middle-left;
    margin-left: 6px;
}

.clip-editor__hierarchy {
    flex-grow: 1;
}

.clip-editor__hierarchy-row {
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* A bone the selected clip already animates. Weight rather than colour, so it still reads in the
 * light theme and against the row's own selection highlight. */
.clip-editor__hierarchy-row--animated {
    -unity-font-style: bold;
}

/* A node the rig declares as a billboard root (amendment A44). Tinted rather than weighted, so it
 * reads as a different KIND of fact from "this clip animates it" and the two can coexist on one
 * row — a billboarded part that is also keyed is common and must not lose either signal. */
.clip-editor__hierarchy-row--billboard-root {
    color: rgb(120, 200, 255);
}

/* A node that inherits a billboard from an ancestor. Deliberately fainter: inheritance is the
 * default state of everything under a root, so marking it as loudly as the root itself would make
 * a whole rig look configured when only one node is. */
.clip-editor__hierarchy-row--billboard-inherited {
    color: rgb(110, 140, 160);
}

/* ------------------------------------------------------------------------------------------- */
/* Viewport                                                                                      */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__viewport-pane {
    min-width: 120px;
}

.clip-editor__viewport-status {
    white-space: normal;
    margin-left: 6px;
    margin-top: 2px;
    margin-bottom: 2px;
    flex-shrink: 0;
}

.clip-editor__viewport-frame {
    flex-grow: 1;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

/* Rig Edit mode. The border is always present and merely transparent in Animate mode, so
   switching modes never reflows the viewport — a layout jump on every toggle would be its own
   kind of ambiguity about what just happened. */
.clip-editor__viewport-frame--rig-edit {
    border-left-color: rgb(226, 138, 44);
    border-right-color: rgb(226, 138, 44);
    border-top-color: rgb(226, 138, 44);
    border-bottom-color: rgb(226, 138, 44);
}

.clip-editor__viewport {
    flex-grow: 1;
}

/* The toggle itself is tinted when on, so the mode is legible from the toolbar as well as from
   the viewport. Three signals for one mode is deliberate: the cost of misreading it is a gizmo
   drag that edits the rig when you meant to key a pose. */
.clip-editor__rig-edit-toggle:checked {
    background-color: rgb(226, 138, 44);
    color: rgb(24, 20, 14);
    -unity-font-style: bold;
}

.clip-editor__mode-banner {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(24, 20, 14);
    background-color: rgb(226, 138, 44);
    padding-top: 3px;
    padding-bottom: 3px;
    flex-shrink: 0;
    white-space: normal;
}

/* ------------------------------------------------------------------------------------------- */
/* Reconciliation                                                                                */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__reconcile {
    flex-shrink: 0;
    max-height: 220px;
    border-top-width: 2px;
    border-top-color: rgb(214, 122, 60);
    background-color: rgba(96, 54, 26, 0.35);
    padding-bottom: 4px;
}

.clip-editor__reconcile-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 6px;
    padding-right: 4px;
    padding-top: 3px;
}

.clip-editor__reconcile-title {
    -unity-font-style: bold;
    color: rgb(240, 186, 138);
    white-space: normal;
    flex-shrink: 1;
}

.clip-editor__reconcile-list {
    max-height: 170px;
}

.clip-editor__reconcile-row {
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.clip-editor__reconcile-row-label {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.clip-editor__reconcile-remap {
    width: 130px;
    flex-shrink: 0;
    margin-right: 4px;
}

/* ------------------------------------------------------------------------------------------- */
/* Inspector                                                                                     */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__inspector {
    flex-grow: 1;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
}

/* ------------------------------------------------------------------------------------------- */
/* Live transform block                                                                          */
/* ------------------------------------------------------------------------------------------- */

/*
 * The left edge carries the state, so the three cases are told apart at a glance without reading
 * the chip: a stored value, a sampled one, and one that will be lost if it is not keyed.
 */
.clip-editor__transform-block {
    padding-left: 6px;
    border-left-width: 3px;
    border-left-color: rgba(128, 128, 128, 0.35);
}

.clip-editor__transform-block--on-key {
    border-left-color: rgb(90, 170, 230);
}

.clip-editor__transform-block--interpolated {
    border-left-color: rgba(140, 140, 145, 0.6);
}

.clip-editor__transform-block--modified {
    border-left-color: rgb(235, 170, 60);
}

.clip-editor__transform-state {
    margin-bottom: 2px;
}

.clip-editor__transform-state.clip-editor__transform-block--modified {
    color: rgb(235, 170, 60);
    opacity: 1;
}

/* ------------------------------------------------------------------------------------------- */
/* Flipbook tracks                                                                               */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__flipbook-track {
    margin-top: 4px;
    margin-bottom: 6px;
    padding-left: 6px;
    padding-bottom: 4px;
    border-left-width: 2px;
    border-left-color: rgba(120, 160, 200, 0.5);
}

/* A key reads left to right as one sentence: what is stored, what it resolves to, how to read it. */
.clip-editor__flipbook-key {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
}

.clip-editor__flipbook-resolved {
    min-width: 76px;
    margin-left: 6px;
    margin-right: 6px;
    -unity-font-style: bold;
    opacity: 0.85;
}

/* A relative key whose base and offset disagree — validation rule V18 reports the same thing. */
.clip-editor__flipbook-resolved--invalid {
    color: rgb(230, 90, 82);
}

.clip-editor__heading {
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 4px;
}

/* Names the object a block of fields belongs to. With several parts selected the inspector is a
   stack of near-identical blocks, so the rule is a separator as much as a label. */
.clip-editor__selection-heading {
    margin-top: 10px;
    padding-top: 6px;
    padding-bottom: 2px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
    font-size: 12px;
}

/* The row the viewport gizmo and outline are on — one of many blocks, but only one of them is
   being pointed at in the scene. */
.clip-editor__selection-heading--active {
    color: rgb(120, 190, 255);
}

/* ------------------------------------------------------------------------------------------- */
/* Timeline                                                                                      */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__status {
    margin-left: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.clip-editor__timeline-scroll {
    flex-grow: 1;
}

.clip-editor__timeline-row {
    flex-direction: row;
    flex-grow: 1;
}

.clip-editor__track-header-stack {
    width: var(--clip-editor-track-header-width);
    flex-shrink: 0;
}

.clip-editor__track-header-spacer {
    height: var(--clip-editor-ruler-height);
    flex-shrink: 0;
}

.clip-editor__track-header {
    height: var(--clip-editor-lane-height);
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    margin-left: 6px;
    overflow: hidden;
}

.clip-editor__track-foldout {
    width: 16px;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
}

.clip-editor__track-header-label {
    overflow: hidden;
    -unity-text-align: middle-left;
}

/* Indented and dimmed, because a channel row reads the same keys as the track above it. */
.clip-editor__channel-header {
    padding-left: 18px;
    opacity: 0.75;
}

.clip-editor__box-select {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.clip-editor__bezier-curve {
    height: 140px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.clip-editor__lane-stack {
    flex-grow: 1;
}

.clip-editor__ruler {
    height: var(--clip-editor-ruler-height);
    flex-shrink: 0;
}

.clip-editor__lane {
    height: var(--clip-editor-lane-height);
    flex-grow: 1;
}

/* Spans the whole lane stack so the current-time line is continuous across every track. */
.clip-editor__playhead {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ------------------------------------------------------------------------------------------- */
/* Validation badge                                                                              */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__validation-badge {
    flex-direction: column;
}

.clip-editor__validation-summary {
    margin-left: 4px;
    margin-right: 4px;
}

.clip-editor__validation-messages {
    margin-left: 8px;
    max-height: 220px;
}

.clip-editor__validation-message {
    -unity-text-align: middle-left;
    white-space: normal;
}
