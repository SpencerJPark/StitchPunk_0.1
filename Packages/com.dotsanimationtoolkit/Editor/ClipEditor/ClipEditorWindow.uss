/* Copyright (c) 2026 Spencer Park. All rights reserved. */

/*
 * Every size and space in the clip editor lives here (architecture section 7.1).
 *
 * The window and its timeline elements set no inline layout styles of their own. That is not
 * tidiness: an inline style beats every rule in this file, so a single leftover `style.height`
 * is a value nobody can override and nobody can find. Colours stay in C# where they encode state
 * (selected, error, warning) and are chosen per draw call by Painter2D rather than by USS.
 *
 * TimeRulerElement, TrackLaneElement, PlayheadElement and ValidationBadgeElement take their sizes
 * from the classes below, so they are only fully styled inside a tree carrying this stylesheet.
 * ClipEditorWindow.uxml is the only place that does; nothing else in the package instantiates them.
 */

/* ------------------------------------------------------------------------------------------- */
/* Root and shared tokens                                                                        */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__root {
    flex-grow: 1;

    /*
     * The header column and the lane column are two separate stacks that must agree row for row.
     * These are the numbers that make them agree: the spacer above the headers is exactly the
     * ruler's height, and a header is exactly a lane's height. Declared once so the alignment
     * cannot be broken by editing one of a pair.
     *
     * A header row whose name will not fit wraps onto a second line, and a wrapped row is exactly
     * two lanes tall — never a measured height. That is what keeps the wrap from sliding every row
     * beneath it out of line with its own keys: there are two row heights, and one class pair sizes
     * the header and the lane together (--wrapped below).
     *
     * The header width is the one size here a user can change: dragging the strip between the two
     * columns writes it inline, which beats this token by design. It is what an unresized window
     * starts at, so editing it still moves every window nobody has dragged.
     */
    --clip-editor-ruler-height: 20px;
    --clip-editor-lane-height: 22px;
    --clip-editor-lane-height-wrapped: 44px;
    --clip-editor-track-header-width: 170px;
}

.clip-editor--hidden {
    display: none;
}

/* ------------------------------------------------------------------------------------------- */
/* Toolbar                                                                                       */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__toolbar {
    flex-shrink: 0;
}

/* Each label heads a pair of fields, so its left margin is the gap between one group and the next
   rather than the gap between two controls. That is the only spacing in this row that is allowed to
   be larger than the others, and it is here rather than inline so both labels cannot drift apart. */
.clip-editor__toolbar-label {
    -unity-text-align: middle-left;
    margin-left: 16px;
    margin-right: 4px;
}

/* The tabs share the top bar with the clip set and rig fields. Flush against Edit Prefab, not set
   apart from it: the -1px carries the same shared-edge trick .clip-editor__bar-action uses, so the
   strip continues the run rather than opening a gap in it. */
.clip-editor__tab-strip {
    flex-direction: row;
    align-items: stretch;
    margin-left: -1px;
}

/*
 * The tab run. Deliberately NOT .clip-editor__bar-action: that rule's own comment says it styles
 * runs of *independent* controls, and these are a radio group — exactly one is on, and clicking the
 * one that is on does nothing. A held-down state is the whole difference, and bar-action has no
 * business defining one for the controls it does style.
 *
 * Wider padding than a bar action, because a tab is a destination rather than a switch and reads as
 * one at a glance only if it is bigger than the switches.
 */
.clip-editor__tab {
    padding-left: 14px;
    padding-right: 14px;
    margin-left: -1px;
    margin-right: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgb(32, 32, 32);
}

/*
 * The active tab. Two signals rather than one: a lighter ground says "this is the one", and the
 * accent underline says which content below belongs to it. Applied by SetActiveTab and by nothing
 * else — the toggle's own checked styling is left alone, because a ToolbarToggle drawn checked and
 * a tab drawn active are different enough that having both would read as two different states.
 */
.clip-editor__tab--active {
    background-color: rgb(76, 76, 76);
    border-bottom-color: rgb(88, 148, 216);
}


/*
 * Every button and toggle that joins a run of them — the top bar, and the Snap / Auto Key group at
 * the head of the key area. One rule, so the two rows cannot drift apart from each other.
 *
 * The top bar had drifted into per-control inline padding plus a hand-placed margin here and there,
 * and the margins read as deliberate grouping when they were only leftovers — the gap before VAT
 * Bake said "these two belong apart" about two controls that belong together. Edit Prefab was worse
 * than spaced wrong: it was a `Button` wearing the pane-action class among ToolbarToggles, so it
 * carried a different height, border and hover state from everything beside it. It is a
 * ToolbarButton now, and this is the only thing that sizes any of them.
 *
 * There is no gap inside a run: the controls read as one segmented strip, and the only spacing left
 * is between runs — the label margin in the top bar, the dropdown margin in the status row.
 *
 * Sitting them flush is not just a matter of dropping the margin, though. Every control draws a
 * border, so two neighbours put two lines side by side and the doubled line reads as the gap that
 * was supposed to be gone. Hence the -1px left margin: it slides each control one pixel over its
 * neighbour so the two borders land in the same pixel column rather than beside it. The later
 * sibling paints last, so a shared edge comes out as exactly one line — which is why the colour
 * has to be opaque. A translucent one would blend twice where borders overlap, and the seams
 * inside a run would end up darker than the two ends.
 *
 * Bordering both edges, rather than one edge plus a hand-placed cap on whichever control happens
 * to be last, is what keeps the ends honest: a run opens and closes with the same line it uses
 * between controls, wherever it ends. That covers a control being added or reordered, and it also
 * covers Quantize Keys, which is absent from the row most of the time — the strip caps itself at
 * whichever control is showing.
 *
 * Add a control to a run, give it this class. That is the whole convention.
 */
.clip-editor__bar-action {
    padding-left: 8px;
    padding-right: 8px;
    margin-left: -1px;
    margin-right: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgb(32, 32, 32);
}

.clip-editor__time-label {
    width: 66px;
}

.clip-editor__object-field {
    width: 200px;
}

.clip-editor__frame-field {
    width: 44px;
}

/* Holds the validation summary button and nothing else. It was a column back when the findings list
   stacked beneath the button inside the bar; the list is over the viewport now, so this is a row. */
.clip-editor__badge-slot {
    flex-direction: row;
    align-items: center;
}

/* ------------------------------------------------------------------------------------------- */
/* Dock and panes                                                                                */
/* ------------------------------------------------------------------------------------------- */

/* Everything under the toolbar. It exists so the VAT Bake pane has something to cover: an overlay
   positions against its own parent, and hung off the root it would have swallowed the toolbar with
   the rest — including the toggle that switches it back off. */
.clip-editor__body {
    flex-grow: 1;
}

.clip-editor__dock {
    flex-grow: 1;
}

/*
 * Every tab that is not the Clip Editor: a pane covering the dock rather than replacing it.
 *
 * Switching by display:none on the dock would be simpler and is the wrong trade. A hidden
 * TwoPaneSplitView still gets a geometry pass, at zero by zero, and a split that clamps its fixed
 * pane against a height of nothing keeps that number: you come back to a collapsed pane and no
 * handle to drag it out with. Covering touches nothing, so the timeline, the preview and all three
 * splits are exactly as you left them when you switch back — which is the point of the tabs.
 *
 * The background is opaque for the same reason it is hardcoded: this is the ground the dock would
 * otherwise show through, and every other surface in this window picks its greys the same way.
 *
 * One rule for all of them, not one per pane. There were three byte-identical copies before the
 * fourth tab arrived, which is three chances for one to drift into a pane that covers the dock
 * slightly differently from its neighbours.
 */
.clip-editor__cover-pane {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(56, 56, 56);
}

/*
 * Minimums, not sizes. TwoPaneSplitView clamps a drag against the panes' min-width / min-height,
 * so these are what stop a boundary being dragged over a pane and leaving it at zero pixels with
 * no visible handle to drag it back out.
 */
.clip-editor__pane {
    flex-direction: column;
    overflow: hidden;
    min-width: 80px;
    min-height: 48px;
}

.clip-editor__pane-title {
    -unity-font-style: bold;
    padding-top: 4px;
    padding-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
}

/* A title with an action button pushed to the right edge of the pane. */
.clip-editor__pane-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.clip-editor__pane-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.clip-editor__pane-action {
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
}

.clip-editor__hint {
    white-space: normal;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 2px;
    margin-bottom: 2px;
    opacity: 0.7;
}

/* ------------------------------------------------------------------------------------------- */
/* Clip list and prefab hierarchy                                                                */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__clip-list {
    flex-grow: 1;
}

.clip-editor__clip-row {
    -unity-text-align: middle-left;
    margin-left: 6px;
}

.clip-editor__hierarchy {
    flex-grow: 1;
}

.clip-editor__hierarchy-row {
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* A bone the selected clip already animates. Weight rather than colour, so it still reads in the
 * light theme and against the row's own selection highlight. */
.clip-editor__hierarchy-row--animated {
    -unity-font-style: bold;
}

/* A node the rig declares as a billboard root (amendment A44). Tinted rather than weighted, so it
 * reads as a different KIND of fact from "this clip animates it" and the two can coexist on one
 * row — a billboarded part that is also keyed is common and must not lose either signal. */
.clip-editor__hierarchy-row--billboard-root {
    color: rgb(120, 200, 255);
}

/* A node that inherits a billboard from an ancestor. Deliberately fainter: inheritance is the
 * default state of everything under a root, so marking it as loudly as the root itself would make
 * a whole rig look configured when only one node is. */
.clip-editor__hierarchy-row--billboard-inherited {
    color: rgb(110, 140, 160);
}

/* ------------------------------------------------------------------------------------------- */
/* Transport bar                                                                                 */
/* ------------------------------------------------------------------------------------------- */

/* Docked directly above the timeline. flex-shrink 0 so it never collapses when the timeline pane
 * is dragged small — a transport you cannot read is worse than a shorter timeline.
 *
 * The bar spans the pane rather than hugging its contents in the middle. Centring the bar itself
 * left the groups in one dense clump with dead space either side, and a clump needs rules drawn
 * between the groups to be read at all. space-evenly keeps the set centred — the end gaps match the
 * ones between groups — while giving each group room of its own, which is what lets the rules go. */
.clip-editor__transport {
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    align-self: stretch;
    width: 100%;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

/* Groups read left to right: move the playhead, read it, define the grid, set playback. Separated
 * by space alone — the rules that used to sit between them read as broken table cells rather than
 * as grouping, and space-evenly on the bar above already spaces the groups further apart than the
 * controls inside them. The padding stays: the gap is the separator now, so removing it too would
 * be removing the grouping rather than the line. */
.clip-editor__transport-group {
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 4px;
    padding-right: 6px;
}

.clip-editor__transport-button {
    min-width: 28px;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 4px;
    padding-right: 4px;
}

.clip-editor__transport-play {
    min-width: 52px;
}

/* Tinted while playing, so the bar answers "is it running" without reading the label. */
.clip-editor__transport-play--playing {
    background-color: rgb(70, 130, 90);
    color: rgb(240, 245, 240);
    -unity-font-style: bold;
}

.clip-editor__transport-label {
    -unity-text-align: middle-left;
    margin-left: 4px;
    margin-right: 2px;
}

.clip-editor__transport-field {
    width: 58px;
}

/* A caption that is also its field's drag handle. The cursor is the only thing that says so, and
 * it is the same one Unity puts on an inspector field's own label. */
.clip-editor__transport-label--draggable {
    cursor: slide-arrow;
}

/* Derived, not authored. Dimmed so it reads as a readout rather than something to type into. */
.clip-editor__transport-derived {
    opacity: 0.7;
    margin-left: 6px;
}

.clip-editor__h-scroller {
    flex-shrink: 0;
    margin-left: 6px;
    margin-right: 6px;
}

/* Wide enough for the longest choice, "Scale From Playhead". The list carries its own heading now
   that there is no label beside it, so a truncated choice would leave the control unexplained. */
.clip-editor__transform-readout {
    -unity-font-style: bold;
    color: rgb(240, 190, 110);
    margin-left: 8px;
    -unity-text-align: middle-left;
}

.clip-editor__transport-slider {
    width: 110px;
    margin-right: 4px;
}

/* Loop is a mode, not an action, so it carries the icon alone and shows its state by staying lit
   rather than by a word next to a box. The icon rides a child element rather than the button's own
   background, which the editor theme uses for the button's chrome. */
.clip-editor__transport-loop {
    width: 28px;
    align-items: center;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
}

/* Drawn at the icon's own 16px so it stays crisp rather than being scaled to the button, and
   dimmed while looping is off so the state reads from the glyph as well as the tint. Picking is
   off: a child that swallows the pointer would make the middle of the button dead to clicks. */
.clip-editor__transport-loop-icon {
    width: 16px;
    height: 16px;
    opacity: 0.55;
}

/* Lit in a muted yellow rather than the play button's green: "playback is running" and "playback
   will wrap" are different facts, and two controls in the same group wearing one colour would read
   as one state. */
.clip-editor__transport-loop--on {
    background-color: rgb(150, 128, 52);
}

.clip-editor__transport-loop--on .clip-editor__transport-loop-icon {
    opacity: 1;
}

/* Appears only when some key does not land on a frame of the current grid. */
/* Quantize Keys, tinted because it is the one control in its run that changes authored data rather
   than a mode. Sizing and dividers come from the shared bar-action rule; this only colours it. */
.clip-editor__quantize-action {
    background-color: rgb(150, 110, 40);
}

/* ------------------------------------------------------------------------------------------- */
/* Viewport                                                                                      */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__viewport-pane {
    min-width: 120px;
}

.clip-editor__viewport-status {
    white-space: normal;
    margin-left: 6px;
    margin-top: 2px;
    margin-bottom: 2px;
    flex-shrink: 0;
}

.clip-editor__viewport-frame {
    flex-grow: 1;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

/* Rig Edit mode. The border is always present and merely transparent in Animate mode, so
   switching modes never reflows the viewport — a layout jump on every toggle would be its own
   kind of ambiguity about what just happened. */
.clip-editor__viewport-frame--rig-edit {
    border-left-color: rgb(226, 138, 44);
    border-right-color: rgb(226, 138, 44);
    border-top-color: rgb(226, 138, 44);
    border-bottom-color: rgb(226, 138, 44);
}

.clip-editor__viewport {
    flex-grow: 1;
}

/* The toggle itself is tinted when on, so the mode is legible from the toolbar as well as from
   the viewport. Three signals for one mode is deliberate: the cost of misreading it is a gizmo
   drag that edits the rig when you meant to key a pose. */
/* Lives in the Rig Hierarchy pane header rather than the toolbar, so it has to read as one of that
   row's buttons (New / Delete / All) rather than as a flat toolbar toggle. A ToolbarToggle outside a
   Toolbar inherits a transparent background and no border, which in a pane header looks like a label
   somebody forgot to style — these rules give it the ordinary button chrome back. It stays a
   ToolbarToggle rather than becoming a Button so its :checked state still reads at a glance and the
   existing bindings are untouched. */
.clip-editor__rig-edit-toggle {
    background-color: rgb(88, 88, 88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(48, 48, 48);
    border-right-color: rgb(48, 48, 48);
    border-top-color: rgb(48, 48, 48);
    border-bottom-color: rgb(48, 48, 48);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.clip-editor__rig-edit-toggle:hover {
    background-color: rgb(103, 103, 103);
}

.clip-editor__rig-edit-toggle:checked {
    background-color: rgb(226, 138, 44);
    color: rgb(24, 20, 14);
    -unity-font-style: bold;
}

.clip-editor__mode-banner {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(24, 20, 14);
    background-color: rgb(226, 138, 44);
    padding-top: 3px;
    padding-bottom: 3px;
    flex-shrink: 0;
    white-space: normal;
}

/* ------------------------------------------------------------------------------------------- */
/* Reconciliation                                                                                */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__reconcile {
    flex-shrink: 0;
    max-height: 220px;
    border-top-width: 2px;
    border-top-color: rgb(214, 122, 60);
    background-color: rgba(96, 54, 26, 0.35);
    padding-bottom: 4px;
}

.clip-editor__reconcile-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 6px;
    padding-right: 4px;
    padding-top: 3px;
}

.clip-editor__reconcile-title {
    -unity-font-style: bold;
    color: rgb(240, 186, 138);
    white-space: normal;
    flex-shrink: 1;
}

.clip-editor__reconcile-list {
    max-height: 170px;
}

.clip-editor__reconcile-row {
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.clip-editor__reconcile-row-label {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.clip-editor__reconcile-remap {
    width: 130px;
    flex-shrink: 0;
    margin-right: 4px;
}

/* ------------------------------------------------------------------------------------------- */
/* Inspector                                                                                     */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__inspector {
    flex-grow: 1;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
}

/* ------------------------------------------------------------------------------------------- */
/* Live transform block                                                                          */
/* ------------------------------------------------------------------------------------------- */

/*
 * The left edge carries the state, so the three cases are told apart at a glance without reading
 * the chip: a stored value, a sampled one, and one that will be lost if it is not keyed.
 */
.clip-editor__transform-block {
    padding-left: 6px;
    border-left-width: 3px;
    border-left-color: rgba(128, 128, 128, 0.35);
}

.clip-editor__transform-block--on-key {
    border-left-color: rgb(90, 170, 230);
}

.clip-editor__transform-block--interpolated {
    border-left-color: rgba(140, 140, 145, 0.6);
}

.clip-editor__transform-block--modified {
    border-left-color: rgb(235, 170, 60);
}

.clip-editor__transform-state {
    margin-bottom: 2px;
}

.clip-editor__transform-state.clip-editor__transform-block--modified {
    color: rgb(235, 170, 60);
    opacity: 1;
}

/* ------------------------------------------------------------------------------------------- */
/* Flipbook tracks                                                                               */
/* ------------------------------------------------------------------------------------------- */

/* One animation component in the inspector's stack. Boxed rather than merely spaced, because the
   panel's question is "what does this object carry", and a component is the unit that answers it —
   the box is what makes a stack of them countable at a glance. */
.clip-editor__component {
    margin-top: 6px;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.02);
}

/* Marks the component whose socket the viewport gizmo is on. With several sockets on one object,
   nothing else on screen says which one a drag would move. */
.clip-editor__component--active {
    border-color: rgba(120, 200, 255, 0.55);
}

/* The object's own Transform or BoneTransform (Task C, D10): every part has one, so it does not
   get the boxed, bordered chrome that says "a component someone added". No border, no fill, no
   header background -- it reads as the object's own heading running straight into its fields,
   not as one more item in the stack below it. */
.clip-editor__component--intrinsic {
    margin-top: 2px;
    margin-bottom: 4px;
    padding-bottom: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.clip-editor__component--intrinsic > .clip-editor__component-header {
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
}

.clip-editor__component--intrinsic > .clip-editor__component-header > .clip-editor__component-title {
    -unity-font-style: normal;
    opacity: 0.8;
}

.clip-editor__component-header {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(255, 255, 255, 0.04);
}

.clip-editor__component-title {
    flex-grow: 1;
    -unity-font-style: bold;
}

/* Says an edit here reaches every clip in the set, not just this one. */
.clip-editor__component-badge {
    font-size: 10px;
    opacity: 0.65;
    margin-right: 4px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.clip-editor__component-remove {
    width: 20px;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

.clip-editor__component-body {
    padding-left: 6px;
    padding-right: 4px;
}

.clip-editor__add-component {
    margin-top: 6px;
    margin-bottom: 8px;
    height: 22px;
}

/* ------------------------------------------------------------------------------------------- */
/* Add Component picker                                                                          */
/* ------------------------------------------------------------------------------------------- */

/* Covers the window so a press anywhere outside the list dismisses it. Deliberately unpainted:
   a scrim would say the window is blocked, and it is not — it is showing a menu. */
.clip-editor__picker-overlay {
    background-color: rgba(0, 0, 0, 0);
}

.clip-editor__picker {
    padding-top: 2px;
    padding-bottom: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    border-radius: 3px;
    background-color: rgb(60, 60, 60);
}

.clip-editor__picker-row {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.clip-editor__picker-row--hovered {
    background-color: rgba(120, 160, 200, 0.35);
}

/* Dimmed but present, and still hoverable — the card is where it says why. Hiding the row instead
   would leave the user hunting for something the menu had decided not to mention. */
.clip-editor__picker-row--unavailable {
    opacity: 0.45;
}

/* The hover card. Floats beside the list rather than inside it, so reading one row's explanation
   never moves the row below it. */
.clip-editor__picker-card {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    border-radius: 3px;
    background-color: rgb(48, 48, 48);
}

.clip-editor__picker-card-title {
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.clip-editor__picker-card-body {
    white-space: normal;
    opacity: 0.85;
}

/* Why it cannot be added, kept visually apart from what it is: one is about this object, the other
   is about the component itself. */
.clip-editor__picker-card-reason {
    white-space: normal;
    margin-top: 5px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    color: rgb(230, 190, 120);
}

.clip-editor__flipbook-track {
    margin-top: 4px;
    margin-bottom: 6px;
    padding-left: 6px;
    padding-bottom: 4px;
    border-left-width: 2px;
    border-left-color: rgba(120, 160, 200, 0.5);
}

/* A key reads left to right as one sentence: what is stored, what it resolves to, how to read it. */
.clip-editor__flipbook-key {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
}

.clip-editor__flipbook-resolved {
    min-width: 76px;
    margin-left: 6px;
    margin-right: 6px;
    -unity-font-style: bold;
    opacity: 0.85;
}

/* A relative key whose base and offset disagree — validation rule V18 reports the same thing. */
.clip-editor__flipbook-resolved--invalid {
    color: rgb(230, 90, 82);
}

.clip-editor__heading {
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 4px;
}

/* Names the object a block of fields belongs to, and — at the far edge of the same row — the
   part's rig-level tag button. With several parts selected the inspector is a stack of
   near-identical blocks, so the separator rule spans the whole row, not just the text. */
.clip-editor__selection-heading-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding-top: 6px;
    padding-bottom: 2px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
}

.clip-editor__selection-heading {
    flex-grow: 1;
    font-size: 12px;
}

/* The row the viewport gizmo and outline are on — one of many blocks, but only one of them is
   being pointed at in the scene. Coloured on the label, not the row: it marks the name, not the
   tag button beside it. */
.clip-editor__selection-heading--active {
    color: rgb(120, 190, 255);
}

.clip-editor__selection-heading-tag-button {
    flex-shrink: 0;
    min-width: 90px;
    margin-left: 4px;
    margin-top: 0;
    margin-bottom: 0;
}

/* ------------------------------------------------------------------------------------------- */
/* Timeline                                                                                      */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__status {
    margin-left: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

/* The status line at the left, and at the right the controls that say what an edit in the key area
   will do: Snap, Auto Key, the scale pivot, and Quantize Keys when there is something to quantize.
   The status is a short sentence that never fills the width, and none of them is about time, so
   they read better at the head of the key area than in the transport bar among the playback
   controls or in the top bar among the asset fields. */
.clip-editor__status-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* The status grows long — a clip name, then its counts, then the focus note — so inside this row it
   is allowed to shrink and trail off rather than shove the controls past the right edge. */
.clip-editor__status-row > .clip-editor__status {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* Held against the right edge by the auto left margin, so they stay put whatever the status beside
   them says. They belong together: each one answers "what will my next edit in the key area do",
   which is a different question from the clip set and rig identity the top bar is for — and the
   answer matters where the editing happens, not two rows up. Quantize Keys joined them from the
   transport bar for that reason: it is an edit to the keys, not a playback control, and it reports
   a state of the keys by appearing at all.

   Quantize leads the run rather than trailing it, because it comes and goes: at the head of a
   right-aligned group it grows leftwards into the status line's slack, and Snap, Auto Key and the
   pivot hold their place instead of sliding under the pointer.

   flex-shrink 0 so the status line is what gives way when the pane narrows. */
.clip-editor__status-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
}

/* No margins: Snap and Auto Key are run members, and the shared rule owns the gap between them. */
.clip-editor__status-toggle {
    flex-shrink: 0;
}

/* The pivot is a field, not a button, so it stays out of the segmented run for the same reason the
   object fields do in the top bar — its own frame inside a flush strip would read as a seam. The
   left margin is the gap between the run and it; the right one holds it off the pane edge. */
.clip-editor__status-dropdown {
    flex-shrink: 0;
    width: 148px;
    margin-left: 8px;
    margin-right: 6px;
}

.clip-editor__timeline-scroll {
    flex-grow: 1;
}

.clip-editor__timeline-row {
    flex-direction: row;
    flex-grow: 1;
}

.clip-editor__track-header-stack {
    width: var(--clip-editor-track-header-width);
    flex-shrink: 0;
}

.clip-editor__track-header-spacer {
    height: var(--clip-editor-ruler-height);
    flex-shrink: 0;
}

/*
 * The strip between the name column and the lanes, and the only way to widen a column too narrow
 * for its names. Five pixels: wide enough to catch without a miss, narrow enough that it costs the
 * lanes nothing. The cursor is what actually advertises it — a wider bar would only be a wider
 * nothing — and the rule joins the two columns rather than decorating either.
 */
.clip-editor__track-header-resizer {
    width: 5px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.35);
    cursor: resize-horizontal;
}

.clip-editor__track-header-resizer:hover {
    background-color: rgba(128, 128, 128, 0.35);
}

/*
 * flex-wrap is what lets a name too wide for the column drop its part half onto a second line
 * instead of being cut off mid-word. The height stays authored either way — see --wrapped below and
 * the token block's note on why a measured height would break the two columns' alignment.
 */
.clip-editor__track-header {
    height: var(--clip-editor-lane-height);
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    -unity-text-align: middle-left;
    margin-left: 6px;
    overflow: hidden;
}

/* Paired with .clip-editor__lane--wrapped, which must carry the same height. ClipEditorWindow
   toggles both from one place so a row and its lane cannot disagree. */
.clip-editor__track-header--wrapped {
    height: var(--clip-editor-lane-height-wrapped);
}

/* Every direct child of a header is exactly one lane tall, so a wrapped row's two lines land on the
   two lanes beside them rather than floating between them. */
.clip-editor__track-foldout {
    width: 16px;
    height: var(--clip-editor-lane-height);
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
}

/*
 * The tag half of a row, and the half that never yields: the tag is what the clip stores its keys
 * against, so it keeps the first line to itself and the part half is what moves down to the second.
 */
.clip-editor__track-header-label {
    height: var(--clip-editor-lane-height);
    overflow: hidden;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

/*
 * The arrow and the part travel as one flex item so a narrow column moves them down together and
 * the second line reads "→ Part". Wrapping the part on its own would leave the arrow trailing the
 * tag, pointing at nothing. flex-shrink so that once it is alone on a line it ellipsizes rather
 * than widening the row.
 */
.clip-editor__track-header-part-group {
    height: var(--clip-editor-lane-height);
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

/*
 * The rig part the tag lands on. Dimmed by opacity rather than a grey literal so it reads as
 * secondary on either editor skin, the same way a channel row is dimmed below.
 */
.clip-editor__track-header-part {
    height: var(--clip-editor-lane-height);
    overflow: hidden;
    flex-shrink: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0.5;
    -unity-text-align: middle-left;
}

/*
 * The arrow between a row's tag and its part (amendment A56): the row's grammar — keys belong to
 * the tag, the tag lands on the part — drawn rather than implied. Fainter than the part so it
 * never reads as content, and never a click target. On a wrapped row it is also the second line's
 * first character, which is what makes that line legible as a continuation.
 */
.clip-editor__track-header-arrow {
    height: var(--clip-editor-lane-height);
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 4px;
    opacity: 0.35;
    -unity-text-align: middle-left;
}

/*
 * Either half of a row's binding when it is a picker (amendment A56). The hover tint is the whole
 * affordance — a bordered button per half would double the row's chrome and halve a 170px column.
 */
.clip-editor__track-header-binding {
    padding-left: 2px;
    padding-right: 2px;
    border-radius: 2px;
}

.clip-editor__track-header-binding:hover {
    background-color: rgba(128, 128, 128, 0.25);
    opacity: 1;
}

/* Indented and dimmed, because a channel row reads the same keys as the track above it. */
.clip-editor__channel-header {
    padding-left: 18px;
    opacity: 0.75;
}

.clip-editor__box-select {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.clip-editor__easing-curve {
    height: 140px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.clip-editor__lane-stack {
    flex-grow: 1;
}

.clip-editor__ruler {
    height: var(--clip-editor-ruler-height);
    flex-shrink: 0;
}

.clip-editor__lane {
    height: var(--clip-editor-lane-height);
    flex-grow: 1;
}

/* The lane belonging to a header that wrapped onto a second line. Paired with
   .clip-editor__track-header--wrapped above; the two heights must stay equal or every row below
   this one drifts away from its own keys. */
.clip-editor__lane--wrapped {
    height: var(--clip-editor-lane-height-wrapped);
}

/* The rows below the last track, filling the timeline to its bottom edge. Its height is the one
   measured value in the window: it is whatever the viewport has left, so it cannot be authored
   here. overflow hidden clips the last row, which is deliberately allowed to overhang — a row that
   stopped short would leave a dead strip along the bottom, and a dead strip is the bug these rows
   exist to remove. flex-shrink 0 so the rows keep a track row's height instead of being squeezed
   to fit the count. */
.clip-editor__ghost-lanes {
    flex-shrink: 0;
    overflow: hidden;
}

.clip-editor__ghost-lane {
    height: var(--clip-editor-lane-height);
    flex-shrink: 0;
}

/* Spans the whole lane stack so the current-time line is continuous across every track. */
.clip-editor__playhead {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ------------------------------------------------------------------------------------------- */
/* Validation badge                                                                              */
/* ------------------------------------------------------------------------------------------- */

/* Only the summary button lives in the top bar now, so this is a row of one. The findings list it
   switches is over in the viewport frame — a Toolbar is one control tall, and a list stacked under
   the button inside it had nowhere to grow but out of the bar and behind the body, which paints
   after it. */
.clip-editor__validation-badge {
    flex-direction: row;
    align-items: center;
}

.clip-editor__validation-summary {
    margin-left: 4px;
    margin-right: 4px;
}

/* The pressed look for the toggle. The button carries the counts either way, so without this the
   only evidence of which way it is switched would be a panel somewhere else on screen. */
.clip-editor__validation-summary--expanded {
    background-color: rgb(70, 96, 124);
}

/*
 * Where the findings hang: a layer over the preview, the size of the viewport frame and ignoring
 * every click, so the panel inside it can be placed by ordinary flex rules against the 3D area's
 * own bounds rather than by four hand-tuned offsets.
 *
 * picking-mode is Ignore on this element and inherited by nothing — the panel's own buttons still
 * take clicks, which is what makes a finding clickable — so an orbit drag started anywhere the
 * panel is not still reaches the viewport beneath.
 */
.clip-editor__viewport-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: flex-end;
    justify-content: flex-start;
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    /* The findings panel's minimum width is larger than this frame can be dragged down to, so
       without this a viewport squeezed to its own minimum would push findings out over the
       inspector beside it. Clipped rather than allowed to escape: this layer's promise is that it
       never reaches past the 3D area.

       This is also why the layer stays frame-sized rather than hugging its rows. The findings
       panel's max-width/max-height are percentages, and a percentage resolves against its parent —
       shrink this to fit the rows and 60% of the viewport quietly becomes 60% of a toolbar. */
    overflow: hidden;
}

/*
 * A row of the overlay — today the viewport tools, and whatever else earns a place over the scene.
 * Right-aligned and growing right-to-left, so adding a control pushes the run leftward over the
 * scene rather than moving every control the user already knows the position of.
 *
 * Opaque, not translucent. These are controls to be read and hit, not a readout laid over the
 * picture — and a translucent run would show the rig through its own borders, where the -1px
 * overlap trick in .clip-editor__bar-action doubles them.
 */
.clip-editor__overlay-row {
    flex-direction: row;
    align-items: center;
    align-self: flex-end;
    margin-bottom: 4px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(56, 56, 56);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(32, 32, 32);
}

/* Starts a new run inside a row. The -1px overlap in .clip-editor__bar-action makes a run read as
   one segmented strip, which is right for the three gizmo modes and right for the two preview
   toggles — but wrong across the join, where it would say those five controls are one group. */
.clip-editor__overlay-run-break {
    margin-left: 8px;
}

/*
 * The findings panel. Hidden until the top bar's button asks for it, and sized to a corner even
 * then: a clip set mid-edit is *expected* to be invalid, so its errors must never cost the space
 * being posed in. The maximums are fractions of the frame rather than pixels so the panel stays a
 * corner of a small viewport as well as of a large one, and the list inside scrolls once it hits
 * them instead of growing the panel over the rig.
 *
 * Nearly opaque rather than fully: enough contrast to read red text on, while still showing that
 * there is a scene underneath rather than a pane that replaced it.
 */
.clip-editor__validation-overlay {
    max-width: 60%;
    max-height: 60%;
    min-width: 180px;
    background-color: rgba(28, 28, 28, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(96, 96, 96);
    border-right-color: rgb(96, 96, 96);
    border-top-color: rgb(96, 96, 96);
    border-bottom-color: rgb(96, 96, 96);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-bottom: 4px;
}

/* Says what the box is. Over a 3D scene an unlabelled panel of coloured text is a guess, and the
   button that explains it is at the far end of another row. */
.clip-editor__validation-overlay-title {
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    white-space: normal;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* flex-shrink so the panel's max-height is what bounds this, rather than the list's content height
   pushing the panel past it. */
.clip-editor__validation-messages {
    flex-shrink: 1;
    margin-left: 2px;
    margin-right: 2px;
}

.clip-editor__validation-message {
    -unity-text-align: middle-left;
    white-space: normal;
}

/* Phase G, G2: the Cutscene Editor's block/moment timeline. A fresh, seconds-based sibling of the
   key-lane stack above (decision G-D2) — sharing these tokens' naming and feel, never RebuildTimeline
   or TimelineGeometry itself. */

.cutscene-editor__clip-block {
    background-color: rgba(80, 140, 200, 0.85);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(20, 40, 60, 0.9);
}

.cutscene-editor__clip-block--selected {
    border-color: rgba(255, 210, 90, 1);
    border-width: 2px;
}

.cutscene-editor__clip-block--loop {
    background-color: rgba(90, 170, 120, 0.85);
}

.cutscene-editor__moment-marker--selected {
    border-width: 2px;
    border-color: rgba(255, 210, 90, 1);
}
