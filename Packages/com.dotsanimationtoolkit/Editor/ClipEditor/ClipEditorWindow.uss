/*
 * Every size and space in the clip editor lives here (architecture section 7.1).
 *
 * The window and its timeline elements set no inline layout styles of their own. That is not
 * tidiness: an inline style beats every rule in this file, so a single leftover `style.height`
 * is a value nobody can override and nobody can find. Colours stay in C# where they encode state
 * (selected, error, warning) and are chosen per draw call by Painter2D rather than by USS.
 *
 * TimeRulerElement, TrackLaneElement, PlayheadElement and ValidationBadgeElement take their sizes
 * from the classes below, so they are only fully styled inside a tree carrying this stylesheet.
 * ClipEditorWindow.uxml is the only place that does; nothing else in the package instantiates them.
 */

/* ------------------------------------------------------------------------------------------- */
/* Root and shared tokens                                                                        */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__root {
    flex-grow: 1;

    /*
     * The header column and the lane column are two separate stacks that must agree row for row.
     * These are the numbers that make them agree: the spacer above the headers is exactly the
     * ruler's height, and a header is exactly a lane's height. Declared once so the alignment
     * cannot be broken by editing one of a pair.
     *
     * A header row whose name will not fit wraps onto a second line, and a wrapped row is exactly
     * two lanes tall — never a measured height. That is what keeps the wrap from sliding every row
     * beneath it out of line with its own keys: there are two row heights, and one class pair sizes
     * the header and the lane together (--wrapped below).
     *
     * The header width is the one size here a user can change: dragging the strip between the two
     * columns writes it inline, which beats this token by design. It is what an unresized window
     * starts at, so editing it still moves every window nobody has dragged.
     */
    --clip-editor-ruler-height: 20px;
    --clip-editor-lane-height: 22px;
    --clip-editor-lane-height-wrapped: 44px;
    --clip-editor-track-header-width: 170px;

    /*
     * Every colour a tab draws from is a token here, not a literal buried in a rule. State
     * colours first (their meaning is fixed across every tab), then the cutscene lane strips,
     * then its marker fills, then the eight-entry event palette. One place to retune a colour
     * without hunting every selector that happens to use it.
     */
    --toolkit-color-accent: rgb(88, 148, 216);
    --toolkit-color-selected: rgb(77, 158, 242);
    --toolkit-color-selected-row: rgba(61, 96, 133, 0.5);
    --toolkit-color-playing: rgb(70, 130, 90);
    --toolkit-color-loop-on: rgb(150, 128, 52);
    --toolkit-color-recording: rgb(190, 70, 60);
    --toolkit-color-holding: rgb(242, 217, 77);
    --toolkit-color-warning: rgb(235, 170, 60);
    --toolkit-color-error: rgb(230, 90, 82);
    --toolkit-color-clean: rgb(115, 200, 122);
    --toolkit-color-rig-edit: rgb(226, 138, 44);
    --toolkit-color-box-border: rgba(255, 255, 255, 0.08);
    --toolkit-color-box-fill: rgba(255, 255, 255, 0.02);
    --toolkit-color-box-header: rgba(255, 255, 255, 0.04);

    --toolkit-color-lane-actor: rgb(88, 148, 216);
    --toolkit-color-lane-prop: rgb(120, 190, 120);
    --toolkit-color-lane-camera: rgb(90, 190, 190);
    --toolkit-color-lane-events: rgb(230, 150, 70);
    --toolkit-color-lane-holds: rgb(230, 200, 80);

    --toolkit-color-marker-root: rgb(166, 217, 140);
    --toolkit-color-marker-mark: rgb(115, 166, 242);
    --toolkit-color-marker-facing: rgb(217, 191, 102);
    --toolkit-color-marker-part: rgb(191, 140, 217);
    --toolkit-color-marker-attach: rgb(115, 204, 204);
    --toolkit-color-marker-camera: rgb(140, 179, 242);
    --toolkit-color-marker-cut: rgb(242, 115, 115);
    --toolkit-color-marker-hold: rgb(242, 217, 77);

    --toolkit-color-event-amber: rgb(235, 170, 60);
    --toolkit-color-event-coral: rgb(235, 110, 90);
    --toolkit-color-event-magenta: rgb(215, 110, 190);
    --toolkit-color-event-violet: rgb(150, 120, 230);
    --toolkit-color-event-teal: rgb(70, 190, 180);
    --toolkit-color-event-lime: rgb(160, 205, 80);
    --toolkit-color-event-pink: rgb(240, 150, 170);
    --toolkit-color-event-mint: rgb(120, 220, 170);

    --toolkit-color-playhead: rgb(242, 92, 77);
    --toolkit-color-box-select-fill: rgba(77, 158, 242, 0.18);
    --toolkit-color-box-select-outline: rgba(115, 184, 255, 0.9);
}

.clip-editor--hidden {
    display: none;
}

/* ------------------------------------------------------------------------------------------- */
/* Shared                                                                                        */
/* ------------------------------------------------------------------------------------------- */

/*
 * Every tab that plays shares one transport shape, and every tab with an inspector-style list
 * shares one boxed-row shape, so a control looks like itself whichever tab it is standing in.
 * The rules below moved here from the Clip Editor's own sections -- renamed clip-editor__* to
 * toolkit-*, colours swapped for the tokens above where they matched -- so nothing here changed
 * shape or shade in the move itself.
 */

.toolkit-transport {
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    align-self: stretch;
    width: 100%;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--toolkit-divider);
}

.toolkit-transport__group {
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 4px;
    padding-right: 8px;
}

/* Every playback control a tab's transport carries -- jump, step, play, loop -- is this one
   shape, iconned rather than labelled, so a run of them reads as one control family across
   tabs. */
.toolkit-icon-button {
    width: 28px;
    height: 22px;
    padding: 2px;
    margin-left: 2px;
    margin-right: 2px;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    border-radius: var(--toolkit-radius-button);
}

.toolkit-icon-button:hover {
    background-color: var(--toolkit-hover);
}

/* On the text path -- an icon that failed to resolve fell back to its word -- the fixed width
   has to give or the label clips; a squeezed control beats a row of blank buttons. */
.toolkit-icon-button--text {
    width: auto;
    min-width: auto;
    padding-left: 4px;
    padding-right: 4px;
}

/* Icon beside a word, for the few actions whose word is the affordance (Add Event opens a
   picker). The icon is lifted out of flow so the button's own text keeps its centring. */
.toolkit-icon-button--with-text {
    flex-direction: row;
    align-items: center;
    width: auto;
    height: var(--toolkit-height-control);
    min-height: var(--toolkit-height-control);
    padding-left: 4px;
    padding-right: 8px;
}

.toolkit-icon-button--with-text > .toolkit-icon-button__icon {
    margin-right: 4px;
}

.toolkit-icon-button__label {
    white-space: nowrap;
}

/* Drawn at its own 16px so it stays crisp rather than being scaled to the button. The tone now
   carries the state, not the alpha -- ToolkitIcons.ApplyIconTone writes Image.tintColor from the
   button's resolved color. Picking is off: a child that swallows the pointer would make the
   middle of the button dead to clicks. */
.toolkit-icon-button__icon {
    width: 16px;
    height: 16px;
    opacity: 1;
}

/* Tinted while playing, so the bar answers "is it running" without reading the label. */
.toolkit-icon-button--playing {
    background-color: var(--toolkit-color-playing);
    color: rgb(240, 245, 240);
    -unity-font-style: bold;
}

/* A mode rather than a momentary action -- loop and its kin show themselves lit rather than
   pressed. */
/* R16/R17: "on" is one neutral fill everywhere; amber read as a warning on the loop button. */
.toolkit-icon-button--lit {
    background-color: var(--unity-colors-button-background);
}

/* A number in the bar is a caption plus the field it labels. */
.toolkit-transport__caption {
    -unity-text-align: middle-left;
    margin-left: 4px;
    margin-right: 2px;
}

/* A caption that is also its field's drag handle. The cursor is the only thing that says so,
   and it is the same one Unity puts on an inspector field's own label. */
.toolkit-transport__caption--draggable {
    cursor: slide-arrow;
}

.toolkit-transport__field {
    width: 58px;
}

/* Derived, not authored. Dimmed so it reads as a readout rather than something to type into. */
.toolkit-transport__derived {
    opacity: 0.7;
    margin-left: 8px;
}

/* For a readout whose text changes every frame. The row is space-evenly and wraps, so a counter
   that grows a digit re-spaces every control beside it; a reserved width holds them still. */
.toolkit-transport__derived--counter {
    width: 148px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

/* The cutscene transport's own status line, beside its Continue button -- shouts only when the
   clock is actually stopped, since a hold nobody notices reads as a cutscene that froze. */
.toolkit-transport__status {
    margin-left: 12px;
    -unity-text-align: middle-left;
    color: rgb(178, 178, 178);
}

.toolkit-transport__status--holding {
    color: var(--toolkit-color-holding);
    -unity-font-style: bold;
}

/* R02 + R05: 13/600, and no side padding -- the header's column already insets it 12px, so an extra
   8px here put every title 8px right of the rows beneath it. Card titles are 13px too; a 12px pane
   title read smaller than the cards inside its own pane. */
.toolkit-pane-title {
    font-size: var(--toolkit-text-title);
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

/* Panes with no column padding (the Clip Editor's, and every flush viewport column) carry the
   inset on the header instead, so a viewport's title lines up with its neighbours'. */
.clip-editor__pane > .toolkit-pane-header,
.toolkit-column--flush > .toolkit-pane-header,
#ragdoll-viewport > .toolkit-pane-header,
#retarget-preview > .toolkit-pane-header,
#texture-packer-header {
    padding-left: var(--toolkit-inset);
    padding-right: var(--toolkit-inset);
}

#texture-packer-header {
    padding-top: 4px;
    padding-bottom: 4px;
}

/* R06: the preview is not a .toolkit-column, so it missed the 8px top every other column has and
   its header sat 8px above Tracks. */
#retarget-preview {
    padding-top: 8px;
}

/* A title with an action button pushed to the right edge of the pane. */
/* Wraps rather than overlaps: a narrow pane pushes the action run onto a second line, which
   is still a header, where an overflow would draw the buttons across the title. */
.toolkit-pane-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    /* R06: every pane header sits on one baseline. Without a height here a header is only as tall
       as its content, so a column that carries an extra action grew taller than its neighbours --
       three MakePaneHeader calls produced three different heights on the Ragdoll tab. min-height,
       not height, so a header that wraps still shows both lines. */
    min-height: 32px;
}

.toolkit-pane-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 1;
}

/* Unity's default button margin leaves 2px between neighbours, which reads as one jammed strip.
   Separate buttons in a header get a real gap; joined runs use .clip-editor__bar-action instead. */
.toolkit-pane-actions > .unity-button,
.toolkit-pane-actions > .unity-toolbar-toggle {
    margin-left: 4px;
    margin-right: 0;
}

.toolkit-pane-action {
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
}

.toolkit-status-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.toolkit-status {
    margin-left: 8px;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

/* The status grows long -- a clip name, then its counts, then the focus note -- so inside its
   row it is allowed to shrink and trail off rather than shove the actions past the right edge. */
.toolkit-status-row > .toolkit-status {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.toolkit-status-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
    margin-right: 0;
}

/* Every status row ends on the 12px inset, footer or not (the actions carried their own 8px). */
.toolkit-status-row {
    padding-right: var(--toolkit-inset);
}

/* Auto Key while on, the Key button's icon -- an edit-armed state layered onto a bar-action
   member rather than a new control family of its own. */
.clip-editor__bar-action.toolkit-bar-action--recording {
    background-color: var(--toolkit-color-recording);
}

/* The status row's toggles used to carry this as a per-control inline style; a class travels
   with the row instead of being retyped at every call site. */
.clip-editor__status-action {
    border-top-width: 1px;
    border-bottom-width: 1px;
}

/* One boxed component in a stack -- the panel's question is "what does this object carry", and
   a box is what makes a stack of them countable at a glance. Shared by every tab that lists
   things this way: the Clip Editor's component stack, the cutscene cast, the actor's layers. */
.toolkit-box {
    margin-top: 8px;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-width: 1px;
    border-color: var(--toolkit-color-box-border);
    border-radius: 3px;
    background-color: var(--toolkit-color-box-fill);
}

.toolkit-box--selected {
    border-color: var(--toolkit-color-selected);
}

/* Marks the box a viewport gizmo or a live preview is on. With several on screen, nothing else
   says which one a drag or a play would move. */
.toolkit-box--active {
    border-color: rgba(120, 200, 255, 0.55);
}

.toolkit-box__header {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: var(--toolkit-color-box-header);
}

/* Title and label give way before the controls beside them do -- a long name ellipsizes, the
   buttons after it never leave the box. */
.toolkit-box__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-font-style: bold;
}

.toolkit-box__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.toolkit-box__starter {
    min-width: 40px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.toolkit-box__body {
    padding-left: 8px;
    padding-right: 4px;
}

/* A row inside a box's body -- a layer, an animation, a cast member -- ruled off from its
   neighbours rather than boxed again, so a stack of boxes never nests a box inside a box. */
.toolkit-box__row {
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: var(--toolkit-color-box-border);
    padding-top: 2px;
    padding-bottom: 2px;
}

.toolkit-box__row--selected {
    background-color: var(--toolkit-color-selected-row);
}

/* Right-aligned, for a box's own add button -- Add Component, Add Layer and the like. */
.toolkit-box__footer {
    flex-direction: row;
    justify-content: flex-end;
}

/* A plain Button, state held by the caller rather than a Toggle -- a checkbox beside an eye
   would be two controls for one fact. */
.toolkit-eye-toggle {
    width: 20px;
    height: 18px;
}

.toolkit-eye-toggle--off .toolkit-icon-button__icon {
    opacity: 0.45;
}

/* A non-bookend layer header is itself the drag handle -- grab and move it to reorder. */
.toolkit-box__header--draggable {
    cursor: move-arrow;
}

.toolkit-box--dragging {
    opacity: 0.5;
}

/* A run of prose sitting under a control that needs one more line of explanation than its label
   can carry. */
/* One muted tone for every hint (the token, not body text at 70% -- that made a second grey), and
   no side margin: a hint sits on its column's inset, under the label or title it explains. */
.toolkit-hint {
    white-space: normal;
    margin: 2px 0;
    color: var(--toolkit-color-muted);
}

.toolkit-heading {
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
}

/* Every tab's asset bar -- a label plus the object field it picks an asset into -- is this one
   row, so the picker at the top of a tab looks like the picker at the top of any other. */
.toolkit-asset-bar {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    /* One height on every tab (measured 30/33/34/36 before) and the same 12px inset on the right as
       on the left, so the primary action never sits closer to the window edge than the first label. */
    min-height: var(--toolkit-height-asset-bar);
    padding-top: 0;
    padding-bottom: 0;
    padding-right: var(--toolkit-inset);
    border-bottom-width: 1px;
    border-bottom-color: var(--toolkit-divider);
}

.toolkit-asset-bar__label {
    -unity-text-align: middle-left;
    margin-left: 12px;
    margin-right: 4px;
}

.toolkit-asset-bar__field {
    width: 200px;
}

/* A label brings its own left margin; a button leading or ending the bar does not, and sat on the
   window edge (Health's Scan project). */
.toolkit-asset-bar > .unity-button {
    margin-left: 8px;
}

/* A column of a multi-column layout -- shared spacing so a tab's columns line up with every
   other tab's columns. */
.toolkit-column {
    flex-grow: 1;
    min-width: 200px;
    padding-top: 8px;
    padding-left: 12px;
    padding-right: 12px;
}

/* The first column against the pane edge has nothing to its left, so it drops the side padding. */
.toolkit-column--flush {
    padding-left: 0;
    padding-right: 0;
}

.toolkit-detail-title {
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 8px;
}

/* Pushes whatever follows it to the far edge of an asset bar without a fixed-width spacer. */
.toolkit-asset-bar__spacer {
    flex-grow: 1;
}

/* A status row pinned to the bottom of its pane rather than sitting wherever it falls in flow. */
.toolkit-status-row--footer {
    margin-top: auto;
    border-top-width: 1px;
    border-top-color: var(--toolkit-divider);
}

.toolkit-text--dim {
    opacity: 0.6;
}

.toolkit-text--warning {
    color: var(--toolkit-color-warning);
}

.toolkit-text--error {
    color: var(--toolkit-color-error);
}

/* A small tag in a wrapping run -- a rig target, a filter, a picked entry. */
.toolkit-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
    margin-bottom: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: var(--toolkit-color-box-border);
    border-radius: 3px;
    background-color: var(--toolkit-color-box-fill);
}

.toolkit-chip--selected {
    border-color: var(--toolkit-color-selected);
}

.toolkit-chip__blocks {
    flex-direction: row;
    margin-left: 8px;
}

.toolkit-chip__block {
    width: 6px;
    height: 8px;
    margin-right: 2px;
    background-color: rgba(255, 255, 255, 0.12);
}

.toolkit-chip__block--filled {
    background-color: var(--toolkit-color-clean);
}

/* A coloured dot standing in for a severity level, beside the row it describes rather than a
   full icon. */
.toolkit-severity-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
    flex-shrink: 0;
}

/* A caption plus a path that can run longer than the row -- the caption holds its width, the
   path ellipsizes rather than wrapping the row taller. */
.toolkit-path-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.toolkit-path-row__caption {
    min-width: 120px;
    flex-shrink: 0;
}

.toolkit-path-row > .unity-button {
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 0;
}

.toolkit-path-row__path {
    flex-grow: 1;
    /* A zero basis stops the path's text width from sizing the row: measured by its text, a long
       folder pushed the browse button past the column edge (Rigs). */
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ------------------------------------------------------------------------------------------- */
/* Toolbar                                                                                       */
/* ------------------------------------------------------------------------------------------- */

/* .toolkit-asset-bar and .toolkit-asset-bar__label live in the Shared section now -- every tab's
   asset bar draws from the same rule. */

/* Health's label gains a count ("Health (12)") as findings come and go. A basis sized for the longest
   likely label, instead of its text, keeps that change from resizing it and nudging every other tab. 104px is "Health (999)"
   (72px of text at 12px) plus padding and borders, with a little to spare. */
.clip-editor__tab--health {
    flex-shrink: 0;
}

/* The Health tab's error count: a badge beside the word, centred on the pill. */
.clip-editor__tab-count.toolkit-badge {
    align-self: center;
    margin-left: 4px;
}

.toolkit-tablist--compact .clip-editor__tab-count {
    display: none;
}

/* Compact tabs are all 28px wide, Health included. Its 104px basis reserves room for the issue
   count in word mode, and flex-basis beats the compact rule's width, so icon mode has to say so
   itself -- otherwise its glyph sits centred in a 104px tab and the strip ends in a gap. */
.toolkit-tablist--compact .clip-editor__tab--health {
    flex-basis: 28px;
}

/*
 * Every button and toggle that joins a run of them — the top bar, and the Snap / Auto Key group at
 * the head of the key area. One rule, so the two rows cannot drift apart from each other.
 *
 * The top bar had drifted into per-control inline padding plus a hand-placed margin here and there,
 * and the margins read as deliberate grouping when they were only leftovers — the gap before VAT
 * Bake said "these two belong apart" about two controls that belong together. This rule is the only
 * thing that sizes any of them.
 *
 * There is no gap inside a run: the controls read as one segmented strip, and the only spacing left
 * is between runs — the label margin in the top bar, the dropdown margin in the status row.
 *
 * Sitting them flush is not just a matter of dropping the margin, though. Every control draws a
 * border, so two neighbours put two lines side by side and the doubled line reads as the gap that
 * was supposed to be gone. Hence the -1px left margin: it slides each control one pixel over its
 * neighbour so the two borders land in the same pixel column rather than beside it. The later
 * sibling paints last, so a shared edge comes out as exactly one line — which is why the colour
 * has to be opaque. A translucent one would blend twice where borders overlap, and the seams
 * inside a run would end up darker than the two ends.
 *
 * Bordering both edges, rather than one edge plus a hand-placed cap on whichever control happens
 * to be last, is what keeps the ends honest: a run opens and closes with the same line it uses
 * between controls, wherever it ends. That covers a control being added or reordered, and it also
 * covers Quantize Keys, which is absent from the row most of the time — the strip caps itself at
 * whichever control is showing.
 *
 * Add a control to a run, give it this class. That is the whole convention.
 */
.clip-editor__bar-action {
    padding-left: 8px;
    padding-right: 8px;
    margin-left: -2px;
    margin-right: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: var(--toolkit-divider);
}

.clip-editor__time-label {
    width: 66px;
}

/* .toolkit-asset-bar__field lives in the Shared section now. */

/* The clip set and rig pickers, one per pane, under the pane's own header. Full width because the
   pane title is the label; the field's own empty text says the type. */
.clip-editor__pane-field {
    margin: 2px 8px 4px 8px;
    flex-shrink: 0;
}

.clip-editor__frame-field {
    width: 44px;
}

/* ------------------------------------------------------------------------------------------- */
/* Dock and panes                                                                                */
/* ------------------------------------------------------------------------------------------- */

/* Everything under the toolbar. It exists so the VAT Bake pane has something to cover: an overlay
   positions against its own parent, and hung off the root it would have swallowed the toolbar with
   the rest — including the toggle that switches it back off. */
.clip-editor__body {
    flex-grow: 1;
}

.clip-editor__dock {
    flex-grow: 1;
}

/*
 * Every tab that is not the Clip Editor: a pane covering the dock rather than replacing it.
 *
 * Switching by display:none on the dock would be simpler and is the wrong trade. A hidden
 * TwoPaneSplitView still gets a geometry pass, at zero by zero, and a split that clamps its fixed
 * pane against a height of nothing keeps that number: you come back to a collapsed pane and no
 * handle to drag it out with. Covering touches nothing, so the timeline, the preview and all three
 * splits are exactly as you left them when you switch back — which is the point of the tabs.
 *
 * The background is opaque for the same reason it is hardcoded: this is the ground the dock would
 * otherwise show through, and every other surface in this window picks its greys the same way.
 *
 * One rule for all of them, not one per pane. There were three byte-identical copies before the
 * fourth tab arrived, which is three chances for one to drift into a pane that covers the dock
 * slightly differently from its neighbours.
 */
.clip-editor__cover-pane {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--toolkit-window);
}

/*
 * Minimums, not sizes. TwoPaneSplitView clamps a drag against the panes' min-width / min-height,
 * so these are what stop a boundary being dragged over a pane and leaving it at zero pixels with
 * no visible handle to drag it back out.
 */
.clip-editor__pane {
    flex-direction: column;
    overflow: hidden;
    min-width: 80px;
    min-height: 48px;
}

/* .toolkit-hint lives in the Shared section now. */

/* ------------------------------------------------------------------------------------------- */
/* Clip list and prefab hierarchy                                                                */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__clip-list {
    flex-grow: 1;
}

.clip-editor__clip-row {
    -unity-text-align: middle-left;
    margin-left: 8px;
}

/* With no clip there are no lanes to read, so the empty state covers the playhead and range lines
   rather than letting them strike through its text. */
.clip-editor__timeline-empty {
    background-color: var(--toolkit-surface);
}

.clip-editor__hierarchy {
    flex-grow: 1;
}

.clip-editor__hierarchy-row {
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* A bone the selected clip already animates. Weight rather than colour, so it still reads in the
 * light theme and against the row's own selection highlight. */
.clip-editor__hierarchy-row--animated {
    -unity-font-style: bold;
}

/* A node the rig declares as a billboard root (amendment A44). Tinted rather than weighted, so it
 * reads as a different KIND of fact from "this clip animates it" and the two can coexist on one
 * row — a billboarded part that is also keyed is common and must not lose either signal. */
.clip-editor__hierarchy-row--billboard-root {
    color: rgb(120, 200, 255);
}

/* A node that inherits a billboard from an ancestor. Deliberately fainter: inheritance is the
 * default state of everything under a root, so marking it as loudly as the root itself would make
 * a whole rig look configured when only one node is. */
.clip-editor__hierarchy-row--billboard-inherited {
    color: rgb(110, 140, 160);
}

/* ------------------------------------------------------------------------------------------- */
/* Transport bar                                                                                 */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__h-scroller {
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 8px;
}

/* Wide enough for the longest choice, "Scale From Playhead". The list carries its own heading now
   that there is no label beside it, so a truncated choice would leave the control unexplained. */
.clip-editor__transform-readout {
    -unity-font-style: bold;
    color: rgb(240, 190, 110);
    margin-left: 8px;
    -unity-text-align: middle-left;
}

.clip-editor__transport-slider {
    width: 110px;
    margin-right: 4px;
}

/* Appears only when some key does not land on a frame of the current grid. */
/* Quantize Keys, tinted because it is the one control in its run that changes authored data rather
   than a mode. Sizing and dividers come from the shared bar-action rule; this only colours it. */
/* Out-ranks the status-row outline rule, which would otherwise clear this fill to transparent. */
.clip-editor__quantize-action,
.toolkit-status-actions > .toolkit-button--secondary.unity-toolbar-button.clip-editor__quantize-action {
    background-color: rgb(150, 110, 40);
}

/* ------------------------------------------------------------------------------------------- */
/* Viewport                                                                                      */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__viewport-pane {
    min-width: 120px;
}

.clip-editor__viewport-status {
    white-space: normal;
    margin-left: 8px;
    margin-top: 2px;
    margin-bottom: 2px;
    flex-shrink: 0;
}

.clip-editor__viewport-frame {
    flex-grow: 1;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

/* Rig Edit mode. The border is always present and merely transparent in Animate mode, so
   switching modes never reflows the viewport — a layout jump on every toggle would be its own
   kind of ambiguity about what just happened. */
.clip-editor__viewport-frame--rig-edit {
    border-left-color: rgb(226, 138, 44);
    border-right-color: rgb(226, 138, 44);
    border-top-color: rgb(226, 138, 44);
    border-bottom-color: rgb(226, 138, 44);
}

.clip-editor__viewport {
    flex-grow: 1;
}

/* A Toolbar control living in a pane header rather than in a Toolbar. Both of the Rig Hierarchy
   header's controls are that — Edit and Prefab — and outside a Toolbar they inherit a transparent
   background and no border, which in a pane header looks like a label somebody forgot to style.
   This gives them the ordinary button chrome back so they read as siblings of the New / Delete
   buttons in the pane above. They stay Toolbar types rather than becoming Buttons so the toggle's
   :checked state still reads at a glance and the existing bindings are untouched. */
.clip-editor__pane-chrome {
    background-color: var(--unity-colors-button-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(48, 48, 48);
    border-right-color: rgb(48, 48, 48);
    border-top-color: rgb(48, 48, 48);
    border-bottom-color: rgb(48, 48, 48);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.clip-editor__pane-chrome:hover {
    background-color: var(--unity-colors-button-hover-background);
}

/* Disabled still has to read as disabled: the chrome above paints an opaque background that would
   otherwise survive the dimming Unity applies to the label alone. Prefab is disabled whenever the
   rig has no source prefab, which is most of the time on a fresh window. */
.clip-editor__pane-chrome:disabled {
    background-color: rgb(70, 70, 70);
}

/* The toggle itself is tinted when on, so the mode is legible from the toolbar as well as from
   the viewport. Three signals for one mode is deliberate: the cost of misreading it is a gizmo
   drag that edits the rig when you meant to key a pose. */
.clip-editor__rig-edit-toggle:checked {
    background-color: rgb(226, 138, 44);
    color: rgb(24, 20, 14);
    -unity-font-style: bold;
}

.clip-editor__mode-banner {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(24, 20, 14);
    background-color: rgb(226, 138, 44);
    padding-top: 4px;
    padding-bottom: 4px;
    flex-shrink: 0;
    white-space: normal;
}

/* ------------------------------------------------------------------------------------------- */
/* Reconciliation                                                                                */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__reconcile {
    flex-shrink: 0;
    max-height: 220px;
    border-top-width: 2px;
    border-top-color: rgb(214, 122, 60);
    background-color: rgba(96, 54, 26, 0.35);
    padding-bottom: 4px;
}

.clip-editor__reconcile-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 8px;
    padding-right: 4px;
    padding-top: 4px;
}

.clip-editor__reconcile-title {
    -unity-font-style: bold;
    color: rgb(240, 186, 138);
    white-space: normal;
    flex-shrink: 1;
}

.clip-editor__reconcile-list {
    max-height: 170px;
}

.clip-editor__reconcile-row {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.clip-editor__reconcile-row-label {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.clip-editor__reconcile-remap {
    width: 130px;
    flex-shrink: 0;
    margin-right: 4px;
}

/* ------------------------------------------------------------------------------------------- */
/* Inspector                                                                                     */
/* ------------------------------------------------------------------------------------------- */

.clip-editor__inspector {
    flex-grow: 1;
    padding-left: var(--toolkit-inset);
    padding-right: var(--toolkit-inset);
    padding-top: 2px;
}

/* ------------------------------------------------------------------------------------------- */
/* Live transform block                                                                          */
/* ------------------------------------------------------------------------------------------- */

/*
 * The left edge carries the state, so the three cases are told apart at a glance without reading
 * the chip: a stored value, a sampled one, and one that will be lost if it is not keyed.
 */
.clip-editor__transform-block {
    padding-left: 8px;
    border-left-width: 3px;
    border-left-color: rgba(128, 128, 128, 0.35);
}

.clip-editor__transform-block--on-key {
    border-left-color: rgb(90, 170, 230);
}

.clip-editor__transform-block--interpolated {
    border-left-color: rgba(140, 140, 145, 0.6);
}

.clip-editor__transform-block--modified {
    border-left-color: rgb(235, 170, 60);
}

.clip-editor__transform-state {
    margin-bottom: 2px;
}

.clip-editor__transform-state.clip-editor__transform-block--modified {
    color: rgb(235, 170, 60);
    opacity: 1;
}

/* ------------------------------------------------------------------------------------------- */
/* Flipbook tracks                                                                               */
/* ------------------------------------------------------------------------------------------- */

/* The object's own Transform or BoneTransform (Task C, D10): every part has one, so it does not
   get the boxed, bordered chrome that says "a component someone added". No border, no fill, no
   header background -- it reads as the object's own heading running straight into its fields,
   not as one more item in the stack below it. */
.clip-editor__component--intrinsic {
    margin-top: 2px;
    margin-bottom: 4px;
    padding-bottom: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.clip-editor__component--intrinsic > .toolkit-box__header {
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
}

.clip-editor__component--intrinsic > .toolkit-box__header > .toolkit-box__title {
    -unity-font-style: normal;
    opacity: 0.8;
}

/* Says an edit here reaches every clip in the set, not just this one. */
.clip-editor__component-badge {
    font-size: 11px;
    opacity: 0.65;
    margin-right: 4px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.clip-editor__component-remove {
    width: 20px;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

.clip-editor__add-component {
    margin-top: 8px;
    margin-bottom: 8px;
    height: 22px;
}

/* ------------------------------------------------------------------------------------------- */
/* Add Component picker                                                                          */
/* ------------------------------------------------------------------------------------------- */

/* Covers the window so a press anywhere outside the list dismisses it. Deliberately unpainted:
   a scrim would say the window is blocked, and it is not — it is showing a menu. */
.clip-editor__picker-overlay {
    background-color: rgba(0, 0, 0, 0);
}

.clip-editor__picker {
    padding-top: 2px;
    padding-bottom: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    border-radius: 3px;
    background-color: rgb(60, 60, 60);
}

.clip-editor__picker-row {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.clip-editor__picker-row--hovered {
    background-color: rgba(120, 160, 200, 0.35);
}

/* Dimmed but present, and still hoverable — the card is where it says why. Hiding the row instead
   would leave the user hunting for something the menu had decided not to mention. */
.clip-editor__picker-row--unavailable {
    opacity: 0.45;
}

/* The hover card. Floats beside the list rather than inside it, so reading one row's explanation
   never moves the row below it. */
.clip-editor__picker-card {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    border-radius: 3px;
    background-color: rgb(48, 48, 48);
}

.clip-editor__picker-card-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.clip-editor__picker-card-body {
    white-space: normal;
    opacity: 0.85;
}

/* Why it cannot be added, kept visually apart from what it is: one is about this object, the other
   is about the component itself. */
.clip-editor__picker-card-reason {
    white-space: normal;
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    color: rgb(230, 190, 120);
}

.clip-editor__flipbook-track {
    margin-top: 4px;
    margin-bottom: 8px;
    padding-left: 8px;
    padding-bottom: 4px;
    border-left-width: 2px;
    border-left-color: rgba(120, 160, 200, 0.5);
}

/* A key reads left to right as one sentence: what is stored, what it resolves to, how to read it. */
.clip-editor__flipbook-key {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.clip-editor__flipbook-resolved {
    min-width: 76px;
    margin-left: 8px;
    margin-right: 8px;
    -unity-font-style: bold;
    opacity: 0.85;
}

/* A relative key whose base and offset disagree — validation rule V18 reports the same thing. */
.clip-editor__flipbook-resolved--invalid {
    color: rgb(230, 90, 82);
}

/* .toolkit-heading lives in the Shared section now. */

/* Names the object a block of fields belongs to, and — at the far edge of the same row — the
   part's rig-level tag button. With several parts selected the inspector is a stack of
   near-identical blocks, so the separator rule spans the whole row, not just the text. */
.clip-editor__selection-heading-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    padding-top: 8px;
    padding-bottom: 2px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
}

.clip-editor__selection-heading {
    flex-grow: 1;
    font-size: 12px;
}

/* The row the viewport gizmo and outline are on — one of many blocks, but only one of them is
   being pointed at in the scene. Coloured on the label, not the row: it marks the name, not the
   tag button beside it. */
.clip-editor__selection-heading--active {
    color: rgb(120, 190, 255);
}

.clip-editor__selection-heading-tag-button {
    flex-shrink: 0;
    min-width: 90px;
    margin-left: 4px;
    margin-top: 0;
    margin-bottom: 0;
}

/* ------------------------------------------------------------------------------------------- */
/* Timeline                                                                                      */
/* ------------------------------------------------------------------------------------------- */

/* The status line at the left, and at the right the controls that say what an edit in the key area
   will do: Snap, Auto Key, the scale pivot, and Quantize Keys when there is something to quantize.
   The status is a short sentence that never fills the width, and none of them is about time, so
   they read better at the head of the key area than in the transport bar among the playback
   controls or in the top bar among the asset fields. The row, the status text and the right-aligned
   run itself are the shared toolkit-status-row / toolkit-status / toolkit-status-actions trio.

   Quantize leads the actions run rather than trailing it, because it comes and goes: at the head of
   a right-aligned group it grows leftwards into the status line's slack, and Snap, Auto Key and the
   pivot hold their place instead of sliding under the pointer. Quantize Keys joined them from the
   transport bar for that reason: it is an edit to the keys, not a playback control, and it reports
   a state of the keys by appearing at all. */

/* No margins: Snap and Auto Key are run members, and the shared rule owns the gap between them. */
.clip-editor__status-toggle {
    flex-shrink: 0;
}

/* The pivot is a field, not a button, so it stays out of the segmented run for the same reason the
   object fields do in the top bar — its own frame inside a flush strip would read as a seam. The
   left margin is the gap between the run and it; the right one holds it off the pane edge. */
.clip-editor__status-dropdown {
    flex-shrink: 0;
    width: 148px;
    margin-left: 8px;
    margin-right: 8px;
}

.clip-editor__timeline-scroll {
    flex-grow: 1;
}

.clip-editor__timeline-row {
    flex-direction: row;
    flex-grow: 1;
}

.clip-editor__track-header-stack {
    width: var(--clip-editor-track-header-width);
    flex-shrink: 0;
}

.clip-editor__track-header-spacer {
    height: var(--clip-editor-ruler-height);
    flex-shrink: 0;
}

/*
 * The strip between the name column and the lanes, and the only way to widen a column too narrow
 * for its names. Five pixels: wide enough to catch without a miss, narrow enough that it costs the
 * lanes nothing. The cursor is what actually advertises it — a wider bar would only be a wider
 * nothing — and the rule joins the two columns rather than decorating either.
 */
.clip-editor__track-header-resizer {
    width: 5px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.35);
    cursor: resize-horizontal;
}

.clip-editor__track-header-resizer:hover {
    background-color: rgba(128, 128, 128, 0.35);
}

/*
 * flex-wrap is what lets a name too wide for the column drop its part half onto a second line
 * instead of being cut off mid-word. The height stays authored either way — see --wrapped below and
 * the token block's note on why a measured height would break the two columns' alignment.
 */
.clip-editor__track-header {
    height: var(--clip-editor-lane-height);
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    -unity-text-align: middle-left;
    margin-left: 8px;
    overflow: hidden;
}

/* Paired with .clip-editor__lane--wrapped, which must carry the same height. ClipEditorWindow
   toggles both from one place so a row and its lane cannot disagree. */
.clip-editor__track-header--wrapped {
    height: var(--clip-editor-lane-height-wrapped);
}

/* A read-only row sampled from an imported AnimationClip: dimmed so it never reads as authored keys. */
.clip-editor__track-header--imported {
    opacity: 0.6;
    -unity-font-style: italic;
}

/* Every direct child of a header is exactly one lane tall, so a wrapped row's two lines land on the
   two lanes beside them rather than floating between them. */
.clip-editor__track-foldout {
    width: 16px;
    height: var(--clip-editor-lane-height);
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
}

/*
 * The tag half of a row, and the half that never yields: the tag is what the clip stores its keys
 * against, so it keeps the first line to itself and the part half is what moves down to the second.
 */
.clip-editor__track-header-label {
    height: var(--clip-editor-lane-height);
    overflow: hidden;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

/*
 * The arrow and the part travel as one flex item so a narrow column moves them down together and
 * the second line reads "→ Part". Wrapping the part on its own would leave the arrow trailing the
 * tag, pointing at nothing. flex-shrink so that once it is alone on a line it ellipsizes rather
 * than widening the row.
 */
.clip-editor__track-header-part-group {
    height: var(--clip-editor-lane-height);
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

/*
 * The rig part the tag lands on. Dimmed by opacity rather than a grey literal so it reads as
 * secondary on either editor skin, the same way a channel row is dimmed below.
 */
.clip-editor__track-header-part {
    height: var(--clip-editor-lane-height);
    overflow: hidden;
    flex-shrink: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0.5;
    -unity-text-align: middle-left;
}

/*
 * The arrow between a row's tag and its part (amendment A56): the row's grammar — keys belong to
 * the tag, the tag lands on the part — drawn rather than implied. Fainter than the part so it
 * never reads as content, and never a click target. On a wrapped row it is also the second line's
 * first character, which is what makes that line legible as a continuation.
 */
.clip-editor__track-header-arrow {
    height: var(--clip-editor-lane-height);
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 4px;
    opacity: 0.35;
    -unity-text-align: middle-left;
}

/*
 * Either half of a row's binding when it is a picker (amendment A56). The hover tint is the whole
 * affordance — a bordered button per half would double the row's chrome and halve a 170px column.
 */
.clip-editor__track-header-binding {
    padding-left: 2px;
    padding-right: 2px;
    border-radius: 2px;
}

.clip-editor__track-header-binding:hover {
    background-color: rgba(128, 128, 128, 0.25);
    opacity: 1;
}

/* Indented and dimmed, because a channel row reads the same keys as the track above it. */
.clip-editor__channel-header {
    padding-left: 16px;
    opacity: 0.75;
}

.clip-editor__box-select {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.clip-editor__easing-curve {
    height: 140px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.clip-editor__lane-stack {
    flex-grow: 1;
}

.clip-editor__ruler {
    height: var(--clip-editor-ruler-height);
    flex-shrink: 0;
}

.clip-editor__lane {
    height: var(--clip-editor-lane-height);
    flex-grow: 1;
}

/* The lane belonging to a header that wrapped onto a second line. Paired with
   .clip-editor__track-header--wrapped above; the two heights must stay equal or every row below
   this one drifts away from its own keys. */
.clip-editor__lane--wrapped {
    height: var(--clip-editor-lane-height-wrapped);
}

/* The rows below the last track, filling the timeline to its bottom edge. Its height is the one
   measured value in the window: it is whatever the viewport has left, so it cannot be authored
   here. overflow hidden clips the last row, which is deliberately allowed to overhang — a row that
   stopped short would leave a dead strip along the bottom, and a dead strip is the bug these rows
   exist to remove. flex-shrink 0 so the rows keep a track row's height instead of being squeezed
   to fit the count. */
.clip-editor__ghost-lanes {
    flex-shrink: 0;
    overflow: hidden;
}

.clip-editor__ghost-lane {
    height: var(--clip-editor-lane-height);
    flex-shrink: 0;
}

/* Spans the whole lane stack so the current-time line is continuous across every track. */
.clip-editor__playhead {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ------------------------------------------------------------------------------------------- */
/* Validation badge                                                                              */
/* ------------------------------------------------------------------------------------------- */

/* Only the summary button lives in the top bar now, so this is a row of one. The findings list it
   switches is over in the viewport frame — a Toolbar is one control tall, and a list stacked under
   the button inside it had nowhere to grow but out of the bar and behind the body, which paints
   after it. */
.clip-editor__validation-badge {
    flex-direction: row;
    align-items: center;
}

/* No box of its own: it only holds count badges, and a box around a pill read as a ring in a ring. */
.clip-editor__validation-summary {
    margin-left: 4px;
    margin-right: 4px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}

/* The pressed look for the toggle. The button carries the counts either way, so without this the
   only evidence of which way it is switched would be a panel somewhere else on screen. */
.clip-editor__validation-summary--expanded {
    background-color: rgb(70, 96, 124);
}

/*
 * Where the findings hang: a layer over the preview, the size of the viewport frame and ignoring
 * every click, so the panel inside it can be placed by ordinary flex rules against the 3D area's
 * own bounds rather than by four hand-tuned offsets.
 *
 * picking-mode is Ignore on this element and inherited by nothing — the panel's own buttons still
 * take clicks, which is what makes a finding clickable — so an orbit drag started anywhere the
 * panel is not still reaches the viewport beneath.
 */
.clip-editor__viewport-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: flex-end;
    justify-content: flex-start;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    /* The findings panel's minimum width is larger than this frame can be dragged down to, so
       without this a viewport squeezed to its own minimum would push findings out over the
       inspector beside it. Clipped rather than allowed to escape: this layer's promise is that it
       never reaches past the 3D area.

       This is also why the layer stays frame-sized rather than hugging its rows. The findings
       panel's max-width/max-height are percentages, and a percentage resolves against its parent —
       shrink this to fit the rows and 60% of the viewport quietly becomes 60% of a toolbar. */
    overflow: hidden;
}

/*
 * The viewport tool rail — the gizmo modes, camera reset and the two preview toggles, run down
 * the scene's left edge instead of across its top. align-self overrides the overlay's own
 * align-items: flex-end (the findings panel's corner), so this is the one child that sits at the
 * opposite side.
 *
 * Opaque, not translucent. These are controls to be read and hit, not a readout laid over the
 * picture — and a translucent run would show the rig through its own borders, where the -1px
 * overlap trick in .clip-editor__overlay-tool-button doubles them.
 */
.clip-editor__overlay-column {
    flex-direction: column;
    align-items: center;
    align-self: flex-start;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: var(--toolkit-window);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(32, 32, 32);
}

/* Starts a new run inside the column. Was a left margin when the rail ran left to right; the
   rail reads top to bottom now, so the break does too. */
.clip-editor__overlay-run-break {
    margin-top: 8px;
}

/*
 * One control in the rail: square and icon-sized rather than word-sized, so six controls fit a
 * strip narrow enough to sit beside the rig instead of over its face. Bordered top and bottom
 * with a -1px top overlap — .clip-editor__bar-action's shared-edge trick turned 90 degrees, so a
 * vertical run reads as one seamless strip the same way the horizontal bars do.
 */
.clip-editor__overlay-tool-button {
    width: 28px;
    height: 28px;
    margin-top: -2px;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(32, 32, 32);
    align-items: center;
    justify-content: center;
}

/* Drawn at the icon's own 16px so it stays crisp rather than scaled to the button — the same
   reasoning as the transport bar's loop icon. picking-mode is Ignore in the UXML so the icon
   never swallows the click meant for the button underneath it. */
.clip-editor__overlay-tool-icon {
    width: 16px;
    height: 16px;
}

/* A ToolbarToggle (unlike ToolbarButton) always builds a checkbox-input placeholder ahead of
   its content — invisible, but still a flex sibling, so justify-content: center on the button
   centred the {placeholder, icon} pair instead of the icon alone and every toggle's icon sat
   right of true centre. Collapsing the placeholder here is what centres the five toggles to
   match Reset Camera, the one plain Button in the rail that never had this sibling. */
.clip-editor__overlay-tool-button .unity-toggle__input {
    display: none;
}

/*
 * The findings panel. Hidden until the top bar's button asks for it, and sized to a corner even
 * then: a clip set mid-edit is *expected* to be invalid, so its errors must never cost the space
 * being posed in. The maximums are fractions of the frame rather than pixels so the panel stays a
 * corner of a small viewport as well as of a large one, and the list inside scrolls once it hits
 * them instead of growing the panel over the rig.
 *
 * Nearly opaque rather than fully: enough contrast to read red text on, while still showing that
 * there is a scene underneath rather than a pane that replaced it.
 */
.clip-editor__validation-overlay {
    max-width: 60%;
    max-height: 60%;
    min-width: 180px;
    background-color: rgba(28, 28, 28, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(96, 96, 96);
    border-right-color: rgb(96, 96, 96);
    border-top-color: rgb(96, 96, 96);
    border-bottom-color: rgb(96, 96, 96);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-bottom: 4px;
}

/* Says what the box is. Over a 3D scene an unlabelled panel of coloured text is a guess, and the
   button that explains it is at the far end of another row. */
.clip-editor__validation-overlay-title {
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    white-space: normal;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* flex-shrink so the panel's max-height is what bounds this, rather than the list's content height
   pushing the panel past it. */
.clip-editor__validation-messages {
    flex-shrink: 1;
    margin-left: 2px;
    margin-right: 2px;
}

.clip-editor__validation-message {
    -unity-text-align: middle-left;
    white-space: normal;
}

/* ------------------------------------------------------------------------------------------- */
/* Cutscene Editor (Phase G / A59 / A60 visual pass)                                             */
/*                                                                                               */
/* The design language is Unity Timeline's: an outliner-style header column on a darker ground   */
/* than the lanes, group rows carrying a per-kind accent strip on their left edge, saturated     */
/* rounded clip blocks, diamond keys, and a full-width ruler. Lane/row heights are inline in the */
/* panel because they multiply into computed content widths; every colour that is *state*        */
/* (selected, bound, broken) lives here as a modifier class, never as an inline colour.          */
/* ------------------------------------------------------------------------------------------- */

.cutscene-editor__viewport {
    background-color: rgb(22, 22, 22);
}

.cutscene-editor__viewport-controls {
    background-color: rgba(34, 34, 34, 0.88);
    border-radius: 3px;
    padding: 2px 8px;
    align-items: center;
}

.cutscene-editor__viewport-overlay {
    background-color: rgba(20, 20, 20, 0.8);
}

.cutscene-editor__row {
    flex-direction: row;
    flex-shrink: 0;
}

/* The Clip Editor's lane look (TrackLaneElement's LaneBackground / LaneAlternate): rows alternate
   shade and carry no divider line, so the alternation itself is what separates one row from the next.
   Declared before --selected so a selected row still wins. */
.cutscene-editor__lane-row {
    background-color: rgb(46, 46, 48);
}

.cutscene-editor__lane-row--alternate {
    background-color: rgb(54, 54, 56);
}

.cutscene-editor__row--selected {
    background-color: rgba(61, 96, 133, 0.5);
}

.cutscene-editor__track-header {
    flex-shrink: 0;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.35);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    padding-left: 8px;
}

/* Per-kind accent strips: which family a row belongs to, readable at timeline-glance distance. */
.cutscene-editor__track-header--actor  { border-left-color: rgb(88, 148, 216); }
.cutscene-editor__track-header--prop   { border-left-color: rgb(120, 190, 120); }
.cutscene-editor__track-header--camera { border-left-color: rgb(90, 190, 190); }
.cutscene-editor__track-header--events { border-left-color: rgb(230, 150, 70); }
.cutscene-editor__track-header--holds  { border-left-color: rgb(230, 200, 80); }

/* Default size and colour, like a Clip Editor track header, rather than small grey text. */
.cutscene-editor__track-header-label {
    -unity-text-align: middle-left;
    overflow: hidden;
}

.cutscene-editor__track-header-label--group {
    -unity-font-style: bold;
}

.cutscene-editor__track-header-label--indent {
    padding-left: 16px;
}

/* Transparent so the row's alternating shade shows through. */
.cutscene-editor__clip-lane,
.cutscene-editor__moment-lane {
    background-color: rgba(0, 0, 0, 0);
}

.cutscene-editor__clip-block {
    background-color: rgb(64, 112, 160);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(100, 152, 200);
    overflow: hidden;
}

.cutscene-editor__clip-block--selected {
    border-color: var(--toolkit-color-selected);
    border-width: 2px;
    background-color: rgb(80, 132, 184);
}

.cutscene-editor__clip-block--loop {
    background-color: rgb(74, 140, 108);
    border-color: rgb(110, 180, 145);
}

.cutscene-editor__clip-block-label {
    font-size: 11px;
    color: rgb(238, 242, 248);
    -unity-text-align: middle-left;
    padding-left: 4px;
}

/* A key is a diamond: the square marker rotated in place. Fill colour stays in C# (it encodes
   which lane family the key belongs to); everything shape-like lives here. */
.cutscene-editor__moment-marker {
    rotate: 45deg;
    border-radius: 1px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}

.cutscene-editor__moment-marker--selected {
    border-width: 2px;
    border-color: var(--toolkit-color-selected);
}

/* The attach lane carries two kinds of moment, so shape carries the difference: an Attach is the
   lane's ordinary diamond, a Detach is a ring. Colour is already spent on lane family. */
.cutscene-editor__moment-marker--attach {
    rotate: 45deg;
}

.cutscene-editor__moment-marker--detach {
    rotate: 0deg;
    border-radius: 6px;
    border-width: 2px;
}

/* An event that holds the clock wears the hold lane's colour as its border — the event's own fill
   still says "event", the ring says "and the clock stops here". */
.cutscene-editor__moment-marker--holding {
    border-width: 3px;
    border-color: rgb(242, 217, 77);
}

/* The hold a holding event implies, drawn on the Holds row but owned by the event: dimmed, and
   not selectable, so nobody edits the shadow instead of the thing casting it. */
.cutscene-editor__moment-marker--derived {
    opacity: 0.45;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.4);
}

/* An Auto facing key hands control back to derivation rather than pinning an angle, so it draws
   hollow (fill supplied as transparent alongside this class) against a Fixed key's solid diamond. */
.cutscene-editor__moment-marker--hollow-diamond {
    rotate: 45deg;
    border-width: 2px;
}

/* A cast row is one line at rest — dot, name, kind chip, then Place/Bind/Select/Frame. The bind
   field below it is opened by the Bind button and is display:none until then, so a panel narrow
   enough to sit beside the viewport still lists the whole cast without scrolling. */
.cutscene-editor__cast-row {
    padding: 2px 2px 2px 4px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.cutscene-editor__cast-row--selected {
    border-left-color: rgb(88, 148, 216);
}

.cutscene-editor__cast-line {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
}

/* The clickable half. It takes the slack so the buttons stay pinned right, and it clips rather
   than pushing them off the edge when the panel is narrow. */
.cutscene-editor__cast-identity {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.cutscene-editor__cast-dot {
    width: 14px;
    flex-shrink: 0;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.cutscene-editor__cast-dot--bound   { color: rgb(115, 217, 115); }
.cutscene-editor__cast-dot--broken  { color: rgb(242, 140, 77); }
.cutscene-editor__cast-dot--unbound { color: rgb(153, 153, 166); }

.cutscene-editor__cast-name {
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(215, 215, 215);
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* Actor or Prop, in the same accent the row's group header wears in the timeline. */
.cutscene-editor__cast-chip {
    font-size: 11px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-left: 4px;
    padding: 0 4px;
    border-width: 1px;
    border-radius: 2px;
    opacity: 0.85;
}

.cutscene-editor__cast-chip--actor {
    color: rgb(88, 148, 216);
    border-color: rgba(88, 148, 216, 0.55);
}

.cutscene-editor__cast-chip--prop {
    color: rgb(120, 190, 120);
    border-color: rgba(120, 190, 120, 0.55);
}

.cutscene-editor__cast-button {
    width: 20px;
    height: 18px;
    min-width: 20px;
    flex-shrink: 0;
    padding: 0;
    margin: 0 0 0 2px;
    justify-content: center;
    align-items: center;
}

/* The width cap is dropped only when the icon failed to resolve and the button fell back to its
   word — a squeezed cast row beats a row of blank buttons. */
.cutscene-editor__cast-button--text {
    width: auto;
    min-width: 0;
    padding: 0 4px;
    font-size: 11px;
}

.cutscene-editor__cast-icon {
    width: 14px;
    height: 14px;
}

.cutscene-editor__cast-bind-field {
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 16px;
}

/* Actor Editor (A71) — the layers column's live indicators. Row chrome now comes from the shared
   toolkit-box family; everything else in the tab still styles itself inline, matching the shell's
   own convention. */
/* The preview's ground while nothing has rendered yet -- the same near-black the Clip Editor's
   viewport clears to, so the two tabs' pictures sit on one colour. */
/* The cast pane's stage readout: quieter than the title beside it, so the pane header reads
   title, then state, then actions. */
.cutscene-editor__cast-status {
    color: rgb(173, 173, 184);
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.actor-editor__viewport-image {
    background-color: rgb(31, 31, 33);
}

.actor-editor__live-dot {
    width: 12px;
    -unity-text-align: middle-center;
    color: rgba(140, 140, 140, 0.55);
}

.actor-editor__live-dot--active {
    color: rgb(90, 220, 120);
}

.actor-editor__drop-indicator {
    height: 2px;
    background-color: var(--toolkit-color-selected);
}


/* A109 — consistency pass 3 */

/* D3: no control touches the header above it. */
.clip-sets-detail-header,
.rigs-detail-header {
    margin-bottom: 8px;
}

/* A path picker inside a property row takes the row's height, not its own 4px margins (the floating folder icon). */
.toolkit-property-row .toolkit-path-row {
    margin-top: 0;
    margin-bottom: 0;
}

/* FB4: the frames grid sits clear of the Import settings card. */
.flipbooks-section-gap {
    margin-top: 12px;
}

.materials-create-target-dropdown {
    min-width: 140px;
    height: 24px;
    margin: 0;
}

/* RT1: header and row cells share one set of column widths; the remaining 8% holds the Remap button. */
.retarget-col-track,
.retarget-col-part,
.retarget-col-status {
    flex-grow: 0;
    min-width: 0;
    padding: 0 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.retarget-col-track {
    flex-basis: 28%;
    flex-shrink: 0;
}

.retarget-col-part {
    flex-basis: 44%;
    flex-shrink: 1;
}

.retarget-col-status {
    flex-basis: 20%;
    flex-shrink: 0;
}

/* Outranks the shared list-row title/meta rules (title grows, meta keeps a left margin and a 65%
   cap), which made cells ignore the column bases the caption row follows. */
.toolkit-list-row > .retarget-col-track.unity-label,
.toolkit-list-row > .retarget-col-part.unity-label,
.toolkit-list-row > .retarget-col-status {
    flex-grow: 0;
    margin: 0;
    max-width: none;
    -unity-text-align: middle-left;
}

/* RT2: roster chips sit in one row with 8px between them; the coverage badge 4px after the name. */
#retarget-roster-strip {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

#retarget-roster-heading {
    margin-right: 8px;
}

.retarget-roster-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.retarget-roster-chip > .toolkit-badge {
    margin-left: 4px;
    align-self: center;
}

.ragdoll-rig-field {
    min-width: 200px;
    flex-shrink: 0;
}

/* RD2: one control row in the viewport header, groups split by a 1px divider (R07). */
.toolkit-header-divider {
    width: 1px;
    height: 16px;
    margin: 0 8px;
    flex-shrink: 0;
    background-color: var(--toolkit-divider);
}

.toolkit-header-toggle {
    margin-left: 8px;
}

/* HE1: the search field stops short so the filter pills are never clipped against it. */
.health-search-field {
    flex-grow: 1;
    max-width: 320px;
    margin-left: var(--toolkit-inset);
    margin-right: 8px;
}

/* Every search box is a field (20px, R10); Unity's toolbar variant is 16px with no border. */
.unity-toolbar-search-field {
    height: var(--toolkit-height-field);
    min-height: var(--toolkit-height-field);
    margin-top: 0;
    margin-bottom: 0;
}

/* The first fix button sat flush under the "How to fix" header; the scale's 8px separates them. */
.health-fix-body {
    padding-top: 8px;
}

/* HE2: every fix is one secondary button of one width, its description centred beside it. */
.health-fix-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.health-fix-button {
    width: 120px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 0;
}

/* CU3: the cutscene inspector gets the column inset every other inspector has (R05). */
.cutscene-inspector-body {
    padding-left: 12px;
    padding-right: 12px;
}

.timeline-toolbar-dropdown {
    height: 24px;
    margin-top: 0;
    margin-bottom: 0;
}

/* ---- A110 polish pass 4 ---------------------------------------------------------------------- */

/* T2 Rigs: every target row one flat 22px height (ticked rows grew by their chips), the node name
   growing, Kind/Tag chips right-aligned at badge height. */
.rigs-target-row {
    height: var(--toolkit-height-row);
    min-height: var(--toolkit-height-row);
    max-height: var(--toolkit-height-row);
    align-items: center;
}

.rigs-target-row > .unity-toggle {
    margin: 0 4px 0 0;
    flex-shrink: 0;
}

.rigs-target-row > .toolkit-list-row__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.rigs-target-chip.unity-button {
    flex-shrink: 0;
    height: 18px;
    min-height: 18px;
    margin: 0 0 0 4px;
}

.rigs-folder-field-group {
    flex-direction: row;
    align-items: center;
}

.rigs-folder-field {
    flex-grow: 1;
    margin: 0;
}

/* T3 Clip Sets: picker meta keeps the card's right inset and trails off instead of clipping. */
.toolkit-list-row__meta.unity-label.clip-sets-picker-meta {
    margin-right: var(--toolkit-inset);
}

.clip-sets-folder-row .toolkit-path-row__path {
    padding-left: 6px;
}

.clip-sets-detail-header .clip-sets-detail-title.unity-label {
    margin-bottom: 0;
    white-space: nowrap;
}

/* T6 Health: fixed columns so every code badge shares one x. */
.health-finding-row__title.unity-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.health-finding-row__asset.unity-label {
    flex-grow: 0;
    flex-shrink: 0;
    width: 140px;
    margin-left: 8px;
}

.health-finding-row__code.toolkit-badge {
    flex-grow: 0;
    flex-shrink: 0;
    width: 40px;
    -unity-text-align: middle-center;
    align-self: center;
    margin-left: 8px;
}

/* Beat .toolkit-badge.unity-label's margin reset (same specificity, later sheet). */
.clip-editor__tab-count.toolkit-badge.unity-label,
.health-finding-row__code.toolkit-badge.unity-label {
    margin-left: 8px;
}

.rigs-folder-field-group {
    flex-grow: 1;
    min-width: 0;
}

.rigs-folder-field {
    flex-shrink: 1;
    min-width: 0;
}

.rigs-folder-field-group > .unity-button {
    flex-shrink: 0;
    margin-right: 0;
}

/* T4 Clip Editor: the empty state starts right of the tool rail (24px buttons + 8px card padding). */
.clip-editor__viewport-empty-overlay {
    position: absolute;
    left: 48px;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* R16: blue means selected. A billboard root keeps normal text; its marker glyph says it. */
.clip-editor__hierarchy-row--billboard-root,
.clip-editor__hierarchy-row--billboard-inherited {
    color: var(--toolkit-text);
}

/* T5 Events */
.events-inspector-body {
    flex-grow: 1;
}

.events-keys-header-badge.toolkit-badge.unity-label {
    margin-left: 8px;
    flex-shrink: 0;
}

/* T8 Capture */
.capture-hint-value {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.capture-time-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: var(--toolkit-height-control);
    padding: 0 var(--toolkit-inset);
}

.capture-time-row__caption {
    margin: 0 8px 0 0;
}

.capture-time-row__slider {
    flex-grow: 1;
    margin: 0;
}

#capture-background-segmented,
#capture-format-segmented {
    align-self: flex-start;
}

/* T12 Stats */
.stats-hint-line {
    margin: 0 var(--toolkit-inset) 8px var(--toolkit-inset);
}

.toolkit-list-row__meta.unity-label.stats-value--empty {
    color: var(--toolkit-color-muted);
}

#stats-sparkline {
    position: relative;
}

.stats-sparkline__empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: var(--toolkit-text-meta);
    color: var(--toolkit-color-muted);
}

/* T10 Actor Profiles: the one empty state fills the viewport frame. */
.actor-editor__viewport-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* T13 Texture Packer: Pack Output node on one label column. */
/* Centred on the title row's midline, pushed to its right end. The component's badge rule
   (align-self: flex-start; margin: 0) out-ranked a one-class selector and pinned it to the top. */
.toolkit-card__header > .texture-packer-output-badge.toolkit-badge.unity-label {
    align-self: center;
    margin: 0 0 0 auto;
}

.texture-packer-output-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--toolkit-height-field);
    padding: 2px 8px;
}

.texture-packer-output-row--first {
    margin-top: 4px;
}

.texture-packer-output-label {
    width: 88px;
    flex-shrink: 0;
    margin: 0;
}

.texture-packer-output-channel-label {
    flex-direction: row;
    align-items: center;
}

.texture-packer-output-invert {
    flex-shrink: 0;
    margin: 0 4px;
    font-size: var(--toolkit-text-meta);
}

.texture-packer-output-value {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 120px;
    margin: 0;
}

.texture-packer-output-presets {
    margin-left: 4px;
    flex-shrink: 0;
}

.texture-packer-output-path {
    font-size: var(--toolkit-text-meta);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.texture-packer-output-path--empty {
    color: var(--toolkit-color-muted);
}

.texture-packer-output-preview {
    align-self: center;
    margin: 4px 0;
}

/* Every thumbnail aspect-fits one square slot, on the list's own surface with a hairline. */
.texture-packer-thumbnail-slot {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    border-radius: var(--toolkit-radius-field);
    border-width: 1px;
    border-color: var(--toolkit-color-hairline);
    background-color: var(--toolkit-window);
}

.texture-packer-thumbnail {
    width: 100%;
    height: 100%;
}

/* T14 Flipbooks */
.flipbooks-zoom-toolbar,
.flipbooks-status-row {
    padding-left: var(--toolkit-inset);
    padding-right: var(--toolkit-inset);
}

/* A badge in a row (pane header, header actions, a tab) centres on the row's midline; the
   component default (flex-start) is for badges stacked in a column. */
.toolkit-pane-header .toolkit-badge.unity-label,
.toolkit-pane-actions .toolkit-badge.unity-label,
.toolkit-list-row .toolkit-badge.unity-label,
.clip-editor__tab-count.toolkit-badge.unity-label {
    align-self: center;
}

/* A segmented control in a property row sizes to its content (style guide: never full width). */
.toolkit-property-row .toolkit-segmented {
    flex-grow: 0;
    align-self: center;
}

/* Status rows: one inset everywhere (12px to the text), a tone dot before the line. A footer inside
   a padded column reaches back over that padding so it spans the column like the list surface. */
.toolkit-status-row {
    padding-left: 4px;
}

.toolkit-status-row--footer {
    min-height: var(--toolkit-height-control);
    padding-right: var(--toolkit-inset);
}

.toolkit-column > .toolkit-status-row--footer {
    margin-left: -12px;
    margin-right: -12px;
}

.toolkit-status-row > .toolkit-status.unity-label {
    margin: 0 0 0 8px;
}

.toolkit-status-row > .toolkit-status.toolkit-status--dotted.unity-label {
    margin-left: 6px;
}

.toolkit-status-row > .toolkit-hint.unity-label,
.toolkit-pane-actions > .toolkit-hint.unity-label {
    margin: 0 0 0 8px;
}

.toolkit-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-left: 8px;
    flex-shrink: 0;
    background-color: var(--toolkit-color-muted);
}

.toolkit-status-dot--warning {
    background-color: var(--toolkit-color-warning);
}

.toolkit-status-dot--error {
    background-color: var(--toolkit-color-error);
}

.toolkit-status-dot--ok {
    background-color: var(--toolkit-color-clean);
}

/* A badge in a property row keeps its pill size instead of growing to the field's width. */
.toolkit-property-row .toolkit-badge.unity-label {
    flex-grow: 0;
    align-self: center;
}

/* A badge that follows text in a row keeps a gap from it (the component resets margin to 0, which
   jammed "NewRig" against its "1/1" count). USS has no sibling selector, so the rows that put a
   badge after a label are named here. */
.toolkit-chip > .toolkit-badge.unity-label,
.toolkit-list-row > .toolkit-badge.unity-label,
.toolkit-card__actions > .toolkit-badge.unity-label,
.toolkit-card__header > .toolkit-badge.unity-label,
.toolkit-pane-actions > .toolkit-badge.unity-label,
.toolkit-pane-header > .toolkit-badge.unity-label {
    margin-left: 6px;
}

/* Measured 0px between "11 bodies" and "8 joints": the badge's own margin reset beat the row gap. */
.toolkit-badge-row > .toolkit-badge.unity-label {
    margin-right: 4px;
}

/* Icon squares in a pane header keep the header's 4px gap (the Clips + and Delete measured 0px). */
.toolkit-pane-actions > .toolkit-icon-square.unity-button,
.toolkit-pane-actions > .toolkit-icon-square.unity-toolbar-button,
.toolkit-pane-actions > .toolkit-icon-square.unity-toolbar-toggle {
    margin-left: 4px;
    margin-right: 0;
}

/* Health toolbar: search | filter (centred) | scan status + Scan project. */
.toolkit-asset-bar.health-toolbar {
    flex-wrap: nowrap;
    padding-left: var(--toolkit-inset);
}

.health-toolbar__side {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.health-toolbar__side--end {
    justify-content: flex-end;
}

.health-toolbar__side > .health-search-field {
    flex-grow: 1;
    max-width: 280px;
    margin: 0 16px 0 0;
}

.health-toolbar > .health-filter {
    flex-shrink: 0;
    align-self: center;
}

.health-scan-status.unity-label {
    flex-shrink: 1;
    min-width: 0;
    margin: 0 12px 0 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.health-toolbar__side--end > .unity-button {
    margin-left: 0;
    flex-shrink: 0;
}

/* Clip Editor transport: timing left, playback on the true centre, playhead + zoom right. The side
   zones share the spare width equally (flex 1 1 0) -- space-evenly left the play controls off-centre
   and put 34px of dead space before "Length". */
.toolkit-transport.clip-editor__transport-zoned {
    justify-content: space-between;
    flex-wrap: nowrap;
    padding-left: 8px;
    padding-right: 8px;
}

.toolkit-transport__zone {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.toolkit-transport__zone--end {
    justify-content: flex-end;
}

.clip-editor__transport-zoned > #transport-core-slot {
    flex-shrink: 0;
    margin: 0 16px;
    padding-right: 0;
}

#transport-end-zone > .toolkit-transport__group {
    margin: 0 0 0 16px;
    padding-right: 0;
}

/* The start zone is also a transport group; its 4px margins and 8px right padding made it 12px
   heavier than the end zone and pushed playback 6px right of centre (measured). */
#transport-start-zone {
    margin: 0;
    padding: 0;
}

/* Zoom is a timeline view control, so it lives on the timeline's own toolbar, split from the editing
   actions by a hairline. Moving it off the transport balanced the two sides so playback can centre. */
.clip-editor__timeline-zoom {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: var(--toolkit-divider);
}

.clip-editor__transport-zoned .toolkit-transport__field,
.clip-editor__transport-zoned .toolkit-transport__caption {
    flex-shrink: 0;
}

/* Hints placed straight in a flush Clip Editor pane sit on the pane's 12px inset, not its edge. */
.clip-editor__pane > .toolkit-hint.unity-label {
    margin: 4px var(--toolkit-inset);
}

/* Unity's own "List is empty": a muted hint on the list's inset rather than body text on the edge. */
.unity-list-view__empty-label {
    color: var(--toolkit-color-muted);
    font-size: var(--toolkit-text-body);
    -unity-text-align: upper-left;
    padding: 8px var(--toolkit-inset);
    margin: 0;
}

/* Every viewport's empty state: fills the frame, centred, text on a card over the grid. */
.toolkit-viewport-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.toolkit-viewport-empty-card {
    align-items: center;
    max-width: 480px;
    padding: 12px 16px;
    border-width: 1px;
    border-color: var(--toolkit-color-hairline);
    border-radius: var(--toolkit-radius-card);
    background-color: var(--toolkit-surface);
}

.toolkit-viewport-empty-card > .toolkit-empty__why.unity-label {
    margin-bottom: 0;
}

/* Viewport status lines placed straight under a preview sit on the column's 12px inset. */
#retarget-preview-status,
#rig-preview-status,
#actor-editor-viewport-status {
    margin: 4px var(--toolkit-inset);
}

/* The Keys count sits beside its title, not floating mid-header between title and actions. */
.toolkit-pane-header > .events-keys-header-badge.toolkit-badge.unity-label {
    margin-left: 8px;
    margin-right: auto;
}
