<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="squad-hud-root" picking-mode="Ignore" style="position: absolute; top: 12px; left: 0px; right: 0px; flex-direction: row; justify-content: center;">
        <ui:VisualElement name="squad-hud-row" style="flex-direction: row; background-color: rgba(20, 20, 20, 0.7); padding: 6px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;">
            <ui:VisualElement name="squad-1" style="padding: 4px 10px; margin-right: 6px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; background-color: rgba(217, 64, 64, 0.35);">
                <ui:Label name="squad-1-label" text="Red 0" style="color: rgb(240, 230, 200); font-size: 15px;" />
            </ui:VisualElement>
            <ui:VisualElement name="squad-2" style="padding: 4px 10px; margin-right: 6px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; background-color: rgba(77, 128, 242, 0.35);">
                <ui:Label name="squad-2-label" text="Blue 0" style="color: rgb(240, 230, 200); font-size: 15px;" />
            </ui:VisualElement>
            <ui:VisualElement name="squad-3" style="padding: 4px 10px; margin-right: 6px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; background-color: rgba(77, 204, 102, 0.35);">
                <ui:Label name="squad-3-label" text="Green 0" style="color: rgb(240, 230, 200); font-size: 15px;" />
            </ui:VisualElement>
            <ui:VisualElement name="squad-4" style="padding: 4px 10px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; background-color: rgba(242, 217, 77, 0.35);">
                <ui:Label name="squad-4-label" text="Yellow 0" style="color: rgb(240, 230, 200); font-size: 15px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
