<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="resource-hud-root" style="position: absolute; top: 12px; left: 12px; flex-direction: row; background-color: rgba(20, 20, 20, 0.7); padding: 6px;">
        <ui:Label name="bodies-label" text="Bodies 0" style="color: rgb(240, 230, 200); font-size: 16px; margin-right: 12px;" />
        <ui:Label name="wood-label" text="Wood 0" style="color: rgb(240, 230, 200); font-size: 16px; margin-right: 12px;" />
        <ui:Label name="scrap-label" text="Scrap 0" style="color: rgb(240, 230, 200); font-size: 16px; margin-right: 12px;" />
        <ui:Label name="electricity-label" text="Electricity 0" style="color: rgb(240, 230, 200); font-size: 16px; margin-right: 12px;" />
        <ui:Label name="rounds-label" text="Rounds 0" style="color: rgb(240, 230, 200); font-size: 16px; margin-right: 12px;" />
        <ui:Label name="currency-label" text="Currency 0" style="color: rgb(240, 230, 200); font-size: 16px;" />
    </ui:VisualElement>
    <ui:Label name="clock-label" text="Week 1 · Mon 06:00" style="position: absolute; top: 52px; left: 12px; color: rgb(240, 230, 200); font-size: 14px; background-color: rgba(20, 20, 20, 0.7); padding: 3px 6px;" />
    <ui:VisualElement name="orders-hud" style="position: absolute; top: 84px; left: 12px; background-color: rgba(20, 20, 20, 0.7); padding: 4px 6px; min-width: 220px;">
        <ui:Button name="letter-button" text="Letter" style="min-height: 28px; font-size: 14px; margin-bottom: 4px; display: none;" />
        <ui:VisualElement name="orders-list" />
    </ui:VisualElement>
    <ui:Label name="toast-label" text="" style="position: absolute; top: 90px; left: 50%; width: 460px; margin-left: -230px; -unity-text-align: middle-center; color: rgb(240, 230, 200); font-size: 20px; background-color: rgba(20, 20, 20, 0.8); padding: 8px; white-space: normal; display: none;" />
</ui:UXML>
