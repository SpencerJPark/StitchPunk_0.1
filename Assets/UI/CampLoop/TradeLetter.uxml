<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="trade-letter-root" style="position: absolute; left: 50%; top: 4%; width: 560px; max-height: 92%; margin-left: -280px; flex-direction: column; background-color: rgb(222, 205, 165); border-left-color: rgb(90, 60, 35); border-right-color: rgb(90, 60, 35); border-top-color: rgb(90, 60, 35); border-bottom-color: rgb(90, 60, 35); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; padding: 14px; display: none;">
        <ui:Label name="letter-title" text="A letter has arrived" style="color: rgb(60, 35, 20); font-size: 22px; -unity-font-style: bold; margin-bottom: 8px; flex-shrink: 0;" />
        <ui:ScrollView name="offer-list" style="flex-grow: 0; flex-shrink: 1;" />
        <ui:Label name="client-footer" text="" style="color: rgb(90, 65, 45); font-size: 13px; margin-top: 8px; white-space: normal; flex-shrink: 0;" />
        <ui:Button name="close-button" text="Close" style="min-height: 32px; font-size: 15px; margin-top: 10px; flex-shrink: 0;" />
    </ui:VisualElement>
</ui:UXML>
