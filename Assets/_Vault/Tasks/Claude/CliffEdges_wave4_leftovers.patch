+using System.Collections.Generic;
+using NUnit.Framework;
+using UnityEngine;
+
+namespace StitchPunk.Tests
+{
+    public class TerraceHillBankFieldTests
+    {
+        private const int SamplesPerMetre = 4;
+        private const int SampleSide = 100 * SamplesPerMetre + 1;
+        private const float BankMetres = 8f;
+
+        private readonly List<TerrainTileData> tilesToDestroy = new List<TerrainTileData>();
+
+        [TearDown]
+        public void DestroyTiles()
+        {
+            foreach (TerrainTileData tile in tilesToDestroy)
+            {
+                Object.DestroyImmediate(tile);
+            }
+            tilesToDestroy.Clear();
+        }
+
+        private TerrainTileData BuildTile(Vector2Int coordinate, int firstRaisedCellX)
+        {
+            TerrainTileData tile = ScriptableObject.CreateInstance<TerrainTileData>();
+            tile.coordinate = coordinate;
+            int cellsPerSide = TerrainTileData.TerraceCellsPerSide;
+            byte[] levels = new byte[cellsPerSide * cellsPerSide];
+            for (int cellZ = 0; cellZ < cellsPerSide; cellZ++)
+            {
+                for (int cellX = 0; cellX < cellsPerSide; cellX++)
+                {
+                    int level = cellX >= firstRaisedCellX ? 1 : 0;
+                    levels[cellZ * cellsPerSide + cellX] = (byte)(level + TerrainTileData.TerraceLevelBias);
+                }
+            }
+            tile.baseTerraceLevels = levels;
+            tilesToDestroy.Add(tile);
+            return tile;
+        }
+
+        private float[] BuildField(TerrainTileData tile, TerrainTileData other)
+        {
+            return TerraceHillBankField.BuildBankFactor(
+                tile, 1,
+                (Vector2Int coordinate) => coordinate == other.coordinate ? other : null,
+                SamplesPerMetre, BankMetres);
+        }
+
+        private static float SampleAt(float[] field, float localXMetres, float localZMetres)
+        {
+            int sampleX = Mathf.RoundToInt(localXMetres * SamplesPerMetre);
+            int sampleZ = Mathf.RoundToInt(localZMetres * SamplesPerMetre);
+            return field[sampleZ * SampleSide + sampleX];
+        }
+
+        [Test]
+        public void DistanceToCasePieceMatchesTheAnalyticCurve()
+        {
+            Assert.AreEqual(0.7f, TerraceHillBankField.DistanceToCasePiece(3, new Vector2(0.5f, 1.7f)), 1e-4f);
+            Assert.AreEqual(Mathf.Sqrt(2f) - 1f, TerraceHillBankField.DistanceToCasePiece(1, new Vector2(1f, 1f)), 1e-4f);
+            // (2,0) is 45 degrees below the arc centre (0,2), inside the quarter, so the radial distance applies.
+            Assert.AreEqual(Mathf.Sqrt(8f) - 1f, TerraceHillBankField.DistanceToCasePiece(1, new Vector2(2f, 0f)), 1e-4f);
+            // (0.5,2.5) lies at 45 degrees above the centre, outside the quarter; nearest piece point is the endpoint (1,2).
+            Assert.AreEqual(Mathf.Sqrt(0.5f), TerraceHillBankField.DistanceToCasePiece(1, new Vector2(0.5f, 2.5f)), 1e-4f);
+        }
+
+        [Test]
+        public void BankFallsFromOneToZeroAcrossTheBankAndAgreesAtTheSeam()
+        {
+            TerrainTileData tileA = BuildTile(new Vector2Int(0, 0), 0);
+            TerrainTileData tileAWithRaisedEdge = BuildTile(new Vector2Int(0, 0), 0);
+            TerrainTileData tileB = BuildTile(new Vector2Int(1, 0), 1000);
+
+            // Plateau occupies cells x < 40: raise x < 40 by building inverted levels.
+            int cellsPerSide = TerrainTileData.TerraceCellsPerSide;
+            for (int cellZ = 0; cellZ < cellsPerSide; cellZ++)
+            {
+                for (int cellX = 0; cellX < cellsPerSide; cellX++)
+                {
+                    int level = cellX < 40 ? 1 : 0;
+                    tileA.baseTerraceLevels[cellZ * cellsPerSide + cellX] = (byte)(level + TerrainTileData.TerraceLevelBias);
+                }
+            }
+
+            float[] field = BuildField(tileA, tileB);
+            float zMetres = 50f;
+            Assert.AreEqual(1f, SampleAt(field, 20f, zMetres), 1e-4f);
+            float outsideValue = SampleAt(field, 45f, zMetres);
+            Assert.Greater(outsideValue, 0f);
+            Assert.Less(outsideValue, 1f);
+            Assert.AreEqual(0f, SampleAt(field, 60f, zMetres), 1e-4f);
+
+            float previousValue = SampleAt(field, 40f, zMetres);
+            for (float xMetres = 40.25f; xMetres <= 50f; xMetres += 0.25f)
+            {
+                float value = SampleAt(field, xMetres, zMetres);
+                Assert.LessOrEqual(value, previousValue + 1e-5f, "not monotonic at x=" + xMetres);
+                previousValue = value;
+            }
+
+            // Seam: plateau touching the east edge of tile A.
+            TerrainTileData seamTileA = tileAWithRaisedEdge;
+            tileAWithRaisedEdge.coordinate = new Vector2Int(0, 0);
+            for (int cellZ = 0; cellZ < cellsPerSide; cellZ++)
+            {
+                for (int cellX = 0; cellX < cellsPerSide; cellX++)
+                {
+                    int level = cellX >= 96 ? 1 : 0;
+                    seamTileA.baseTerraceLevels[cellZ * cellsPerSide + cellX] = (byte)(level + TerrainTileData.TerraceLevelBias);
+                }
+            }
+
+            float[] fieldA = BuildField(seamTileA, tileB);
+            float[] fieldB = TerraceHillBankField.BuildBankFactor(
+                tileB, 1,
+                (Vector2Int coordinate) => coordinate == seamTileA.coordinate ? seamTileA : null,
+                SamplesPerMetre, BankMetres);
+
+            for (int sampleZ = 0; sampleZ < SampleSide; sampleZ++)
+            {
+                Assert.AreEqual(fieldA[sampleZ * SampleSide + (SampleSide - 1)], fieldB[sampleZ * SampleSide], 1e-4f,
+                    "seam mismatch at sample z " + sampleZ);
+            }
+
+            float nearSeamValue = SampleAt(fieldB, 4f, 50f);
+            Assert.Greater(nearSeamValue, 0f);
+            Assert.Less(nearSeamValue, 1f);
+        }
+    }
+}
