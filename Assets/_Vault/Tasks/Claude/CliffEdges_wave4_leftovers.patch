diff --git a/Assets/_Scripts/Editor/Terrain/Terraces/TerraceHillBankField.cs b/Assets/_Scripts/Editor/Terrain/Terraces/TerraceHillBankField.cs
new file mode 100644
index 00000000..4c4e4925
--- /dev/null
+++ b/Assets/_Scripts/Editor/Terrain/Terraces/TerraceHillBankField.cs
@@ -0,0 +1,186 @@
+#if UNITY_EDITOR
+using System;
+using UnityEngine;
+
+// HL-D2 far field: 1 inside a hill step, smoothstep falling to 0 at bankMetres outside the CE-D1 case contour.
+// TerraceCaseContour.SignedDistanceInCell is clamped to +-1 m for seam continuity, so the magnitude is rebuilt here from the analytic pieces.
+public static class TerraceHillBankField
+{
+    private const int TileCells = TerrainTileData.TerraceCellsPerSide;
+    private const int CellsPerSide = 50;
+    private const float CellMetres = 2f;
+
+    // Same layout as TerraceEdgeTileOutline.BuildSignedDistanceFromCaseContour: side = 100 * samplesPerMetre + 1, index z * side + x.
+    public static float[] BuildBankFactor(
+        TerrainTileData data,
+        int threshold,
+        Func<Vector2Int, TerrainTileData> neighbourLookup,
+        int samplesPerMetre,
+        float bankMetres)
+    {
+        int paddingCells = Mathf.CeilToInt(bankMetres / CellMetres) + 1;
+        int reachCells = Mathf.CeilToInt((bankMetres + 1f) / CellMetres);
+        int cellsSide = CellsPerSide + 2 * paddingCells;
+        int cornersSide = cellsSide + 1;
+        int[] cornerLevels = BuildPaddedCornerLevels(data, neighbourLookup, paddingCells);
+
+        // Cell (cellX, cellZ) in tile cell coordinates (may be negative) lives at (cellZ + padding) * cellsSide + cellX + padding.
+        int[] caseIndexPerCell = new int[cellsSide * cellsSide];
+        for (int cellZ = 0; cellZ < cellsSide; cellZ++)
+        {
+            for (int cellX = 0; cellX < cellsSide; cellX++)
+            {
+                caseIndexPerCell[cellZ * cellsSide + cellX] = TerraceCaseContour.CaseFor(
+                    cornerLevels[(cellZ + 1) * cornersSide + cellX],
+                    cornerLevels[(cellZ + 1) * cornersSide + cellX + 1],
+                    cornerLevels[cellZ * cornersSide + cellX + 1],
+                    cornerLevels[cellZ * cornersSide + cellX],
+                    threshold);
+            }
+        }
+
+        int side = TileCells * samplesPerMetre + 1;
+        float[] bankFactor = new float[side * side];
+        for (int sampleZ = 0; sampleZ < side; sampleZ++)
+        {
+            float localZ = sampleZ / (float)samplesPerMetre;
+            int ownCellZ = Math.Min((int)(localZ / CellMetres), CellsPerSide - 1);
+            for (int sampleX = 0; sampleX < side; sampleX++)
+            {
+                float localX = sampleX / (float)samplesPerMetre;
+                int ownCellX = Math.Min((int)(localX / CellMetres), CellsPerSide - 1);
+
+                int ownCase = caseIndexPerCell[(ownCellZ + paddingCells) * cellsSide + ownCellX + paddingCells];
+                float signedDistance = TerraceCaseContour.SignedDistanceInCell(
+                    ownCase, new Vector2(localX - ownCellX * CellMetres, localZ - ownCellZ * CellMetres));
+                if (signedDistance >= 0f)
+                {
+                    bankFactor[sampleZ * side + sampleX] = 1f;
+                    continue;
+                }
+
+                float nearestDistance = float.MaxValue;
+                int firstZ = Math.Max(ownCellZ - reachCells, -paddingCells);
+                int lastZ = Math.Min(ownCellZ + reachCells, CellsPerSide + paddingCells - 1);
+                int firstX = Math.Max(ownCellX - reachCells, -paddingCells);
+                int lastX = Math.Min(ownCellX + reachCells, CellsPerSide + paddingCells - 1);
+                for (int cellZ = firstZ; cellZ <= lastZ; cellZ++)
+                {
+                    for (int cellX = firstX; cellX <= lastX; cellX++)
+                    {
+                        int caseIndex = caseIndexPerCell[(cellZ + paddingCells) * cellsSide + cellX + paddingCells];
+                        if (caseIndex == 0 || caseIndex == 15)
+                        {
+                            continue;
+                        }
+
+                        float distance = DistanceToCasePiece(
+                            caseIndex, new Vector2(localX - cellX * CellMetres, localZ - cellZ * CellMetres));
+                        if (distance < nearestDistance)
+                        {
+                            nearestDistance = distance;
+                        }
+                    }
+                }
+
+                if (nearestDistance >= bankMetres)
+                {
+                    continue;
+                }
+
+                float ramp = Mathf.Clamp01((bankMetres - nearestDistance) / bankMetres);
+                bankFactor[sampleZ * side + sampleX] = ramp * ramp * (3f - 2f * ramp);
+            }
+        }
+
+        return bankFactor;
+    }
+
+    // Cell-local metres 0..2 (the point may lie outside the cell). Corners TL(0,2) TR(2,2) BR(2,0) BL(0,0).
+    public static float DistanceToCasePiece(int caseIndex, Vector2 cellLocalMetres)
+    {
+        switch (caseIndex)
+        {
+            case 3:
+            case 12:
+                return DistanceToSegment(cellLocalMetres, new Vector2(0f, 1f), new Vector2(2f, 1f));
+            case 6:
+            case 9:
+                return DistanceToSegment(cellLocalMetres, new Vector2(1f, 0f), new Vector2(1f, 2f));
+            case 1:
+            case 14:
+                return DistanceToQuarterArc(cellLocalMetres, new Vector2(0f, 2f), 1f, -1f);
+            case 2:
+            case 13:
+                return DistanceToQuarterArc(cellLocalMetres, new Vector2(2f, 2f), -1f, -1f);
+            case 4:
+            case 11:
+                return DistanceToQuarterArc(cellLocalMetres, new Vector2(2f, 0f), -1f, 1f);
+            case 8:
+            case 7:
+                return DistanceToQuarterArc(cellLocalMetres, new Vector2(0f, 0f), 1f, 1f);
+            case 5:
+                return Mathf.Min(
+                    DistanceToQuarterArc(cellLocalMetres, new Vector2(2f, 2f), -1f, -1f),
+                    DistanceToQuarterArc(cellLocalMetres, new Vector2(0f, 0f), 1f, 1f));
+            case 10:
+                return Mathf.Min(
+                    DistanceToQuarterArc(cellLocalMetres, new Vector2(0f, 2f), 1f, -1f),
+                    DistanceToQuarterArc(cellLocalMetres, new Vector2(2f, 0f), -1f, 1f));
+            default:
+                return float.MaxValue;
+        }
+    }
+
+    // The arc spans the quadrant of the corner that faces the cell interior: (towardCellX, towardCellZ) is that quadrant's sign pair.
+    private static float DistanceToQuarterArc(Vector2 point, Vector2 corner, float towardCellX, float towardCellZ)
+    {
+        float radius = TerraceCaseContour.CornerArcRadiusMetres;
+        Vector2 offset = point - corner;
+        if (offset.x * towardCellX >= 0f && offset.y * towardCellZ >= 0f)
+        {
+            return Mathf.Abs(offset.magnitude - radius);
+        }
+
+        Vector2 endpointAlongX = corner + new Vector2(towardCellX * radius, 0f);
+        Vector2 endpointAlongZ = corner + new Vector2(0f, towardCellZ * radius);
+        return Mathf.Min(Vector2.Distance(point, endpointAlongX), Vector2.Distance(point, endpointAlongZ));
+    }
+
+    private static float DistanceToSegment(Vector2 point, Vector2 segmentStart, Vector2 segmentEnd)
+    {
+        Vector2 along = segmentEnd - segmentStart;
+        float fraction = Mathf.Clamp01(Vector2.Dot(point - segmentStart, along) / along.sqrMagnitude);
+        return Vector2.Distance(point, segmentStart + along * fraction);
+    }
+
+    // Corner index i in -padding..50 + padding sits at tile-local metres 2i; stored at i + padding. Rule matches TerraceEdgeTileOutline.BuildCornerLevels.
+    private static int[] BuildPaddedCornerLevels(
+        TerrainTileData data,
+        Func<Vector2Int, TerrainTileData> neighbourLookup,
+        int paddingCorners)
+    {
+        int marginCells = 2 * paddingCorners + 1;
+        int paddedCells = CellsPerSide * 2 + 2 * marginCells;
+        int[] paddedLevels = TerraceLevelField.BuildPaddedLevels(data, marginCells, neighbourLookup);
+        int cornersSide = CellsPerSide + 2 * paddingCorners + 1;
+        int[] cornerLevels = new int[cornersSide * cornersSide];
+        int[] touching = new int[4];
+        for (int storedZ = 0; storedZ < cornersSide; storedZ++)
+        {
+            for (int storedX = 0; storedX < cornersSide; storedX++)
+            {
+                int firstCellX = 2 * (storedX - paddingCorners) - 1 + marginCells;
+                int firstCellZ = 2 * (storedZ - paddingCorners) - 1 + marginCells;
+                touching[0] = paddedLevels[firstCellZ * paddedCells + firstCellX];
+                touching[1] = paddedLevels[firstCellZ * paddedCells + firstCellX + 1];
+                touching[2] = paddedLevels[(firstCellZ + 1) * paddedCells + firstCellX];
+                touching[3] = paddedLevels[(firstCellZ + 1) * paddedCells + firstCellX + 1];
+                cornerLevels[storedZ * cornersSide + storedX] = TerraceEdgeTileOutline.MajorityTiesHigher(touching);
+            }
+        }
+
+        return cornerLevels;
+    }
+}
